---
import Base from "../layouts/Base.astro";
import { getEntries } from "../lib/entries.ts";

const entries = getEntries();
const sources = new Set(entries.map((entry) => entry.source)).size;

const products = [
  {
    title: "Veille active",
    body: "Les actualités de la CNIL, collectées depuis le flux officiel et publiées en statique, de la plus récente à la plus ancienne.",
    link: "/veille",
    status: "Disponible",
    accent: "border-l-red",
  },
  {
    title: "MCP",
    body: "Un serveur MCP pour interroger le même corpus depuis un assistant, sans quitter la conversation.",
    link: null,
    status: "À venir",
    accent: "border-l-blue",
  },
  {
    title: "Plugin",
    body: "Un plugin pour consulter la veille et préparer une note sans quitter l'outil de travail.",
    link: null,
    status: "À venir",
    accent: "border-l-yellow",
  },
];

const steps = [
  {
    number: "01",
    title: "Collecte",
    body: "Le flux officiel de la CNIL est lu une fois par passe. La réponse brute est conservée telle quelle.",
  },
  {
    number: "02",
    title: "Normalisation",
    body: "Chaque actualité reçoit un identifiant stable, une URL canonique et une date en UTC.",
  },
  {
    number: "03",
    title: "Publication",
    body: "Le site est régénéré à partir des fichiers versionnés. Aucune API, aucun script au chargement.",
  },
];

const loggias = [
  "bg-paper",
  "bg-red",
  "bg-paper",
  "bg-blue",
  "bg-yellow",
  "bg-paper",
  "bg-red",
  "bg-paper",
  "bg-paper",
  "bg-blue",
  "bg-yellow",
  "bg-red",
];
---

<Base
  title="Vitrine — variante Béton"
  description="Variante Béton : la veille juridique publiée en statique, en grille et en couleurs."
  containerClass="max-w-[1120px]"
>
  <section class="grid gap-10 lg:grid-cols-2 lg:items-stretch">
    <div class="flex flex-col justify-center">
      <p class="font-mono text-[0.65rem] uppercase tracking-[0.14em] text-muted">
        Droit du numérique · Automatisation
      </p>
      <h1 class="mt-6 text-5xl sm:text-6xl">
        La veille juridique, publiée en statique.
      </h1>
      <p class="mt-6 max-w-xl text-lg leading-relaxed text-muted">
        Un pipeline qui lit les sources officielles, normalise, versionne dans git et publie. Aucune
        API au chargement, aucun traceur : la page est écrite au moment de la publication.
      </p>

      <div class="mt-8 flex flex-wrap items-center gap-5">
        <a
          href="/veille"
          class="inline-flex items-center gap-2 border-2 border-ink bg-ink px-5 py-3 font-mono text-[0.7rem] font-bold uppercase tracking-[0.12em] text-paper no-underline shadow-hard hover:-translate-x-0.5 hover:-translate-y-0.5 hover:bg-red hover:no-underline hover:shadow-hard-lg"
        >
          Lire la veille <span aria-hidden="true">→</span>
        </a>
        <a href="#methode" class="text-sm text-ink underline decoration-red decoration-2 underline-offset-4">
          La méthode
        </a>
      </div>
    </div>

    <div class="border-2 border-ink bg-paper p-4 shadow-hard">
      <div
        class="flex items-center justify-between border-b-2 border-ink pb-2 font-mono text-[0.6rem] uppercase tracking-[0.14em]"
      >
        <span>vue / corpus</span>
        <span>CNIL</span>
      </div>
      <div class="mt-4 grid grid-cols-4 gap-2 border-2 border-ink bg-concrete p-3" aria-hidden="true">
        {loggias.map((color) => <div class:list={["aspect-[4/5] border-2 border-ink", color]} />)}
      </div>
      <div class="mt-4 flex items-end justify-between gap-4">
        <div>
          <p class="font-mono text-[0.6rem] uppercase tracking-[0.12em] text-muted">Actualités</p>
          <p class="font-mono text-5xl font-bold leading-none">{entries.length}</p>
        </div>
        <p class="font-mono text-[0.65rem] uppercase tracking-[0.12em] text-muted">
          {sources} source{sources > 1 ? "s" : ""} · 0 ko
        </p>
      </div>
    </div>
  </section>

  <section class="mt-14 border-y-2 border-ink py-4">
    <p class="font-mono text-xs uppercase tracking-[0.14em] text-muted">
      Un flux · un snapshot · {entries.length} entrées · zéro serveur
    </p>
  </section>

  <section class="mt-14 border-2 border-ink bg-paper shadow-hard">
    <div
      class="flex items-center justify-between border-b-2 border-ink bg-ink px-4 py-2 font-mono text-[0.6rem] uppercase tracking-[0.14em] text-paper"
    >
      <span>pipeline.log</span>
      <span class="text-paper/70">lecture seule</span>
    </div>
    <div class="overflow-x-auto p-4 font-mono text-xs leading-relaxed sm:p-6 sm:text-sm">
      <p><span class="text-red">$</span> npm run veille</p>
      <p class="text-muted">→ {entries.length} entrées · {sources} source{sources > 1 ? "s" : ""}</p>
      <p class="mt-3"><span class="text-red">$</span> npm run build</p>
      <p class="text-muted">→ 0 ko de JavaScript</p>
    </div>
  </section>

  <section id="methode" class="mt-20 scroll-mt-8">
    <div class="flex items-end justify-between gap-4 border-b-2 border-ink pb-3">
      <h2 class="text-3xl sm:text-4xl">Comment ça marche</h2>
      <span class="font-mono text-[0.65rem] uppercase tracking-[0.12em] text-muted">01—03</span>
    </div>
    <ol class="mt-8 grid border-2 border-ink sm:grid-cols-3">
      {
        steps.map((step) => (
          <li class="border-b-2 border-ink p-5 last:border-b-0 sm:border-b-0 sm:border-r-2 sm:last:border-r-0">
            <span class="font-mono text-xs text-red">{step.number}</span>
            <h3 class="mt-3 text-xl">{step.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-muted">{step.body}</p>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="mt-20">
    <div class="flex items-end justify-between gap-4 border-b-2 border-ink pb-3">
      <h2 class="text-3xl sm:text-4xl">Trois produits</h2>
      <span class="font-mono text-[0.65rem] uppercase tracking-[0.12em] text-muted">01—03</span>
    </div>
    <ul class="mt-8 border-t-2 border-ink">
      {
        products.map((product, index) => (
          <li
            class:list={[
              "grid gap-4 border-b-2 border-l-4 border-ink py-5 pl-4 sm:grid-cols-[3rem_1fr_9rem] sm:items-start sm:gap-6",
              product.accent,
            ]}
          >
            <span class="font-mono text-xs text-muted">{String(index + 1).padStart(2, "0")}</span>
            <div>
              <h3 class="text-xl">{product.title}</h3>
              <p class="mt-2 max-w-2xl text-sm leading-relaxed text-muted">{product.body}</p>
            </div>
            <div class="sm:text-right">
              <span
                class:list={[
                  "font-mono text-[0.6rem] uppercase tracking-[0.12em]",
                  product.link ? "text-red" : "text-muted",
                ]}
              >
                {product.status}
              </span>
              {product.link && (
                <a
                  href={product.link}
                  class="mt-3 block font-mono text-[0.65rem] uppercase tracking-[0.12em] text-ink no-underline hover:no-underline"
                >
                  Découvrir <span aria-hidden="true">→</span>
                </a>
              )}
            </div>
          </li>
        ))
      }
    </ul>
  </section>
</Base>
