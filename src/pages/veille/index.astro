---
import Base from "../../layouts/Base.astro";
import { getVisibleEntries, isRedundantSummary } from "../../lib/entries.ts";
import { sourceLabel } from "../../lib/sources.ts";
import { activeThemes, readThemes } from "../../../veille/themes.ts";

const allThemes = readThemes();
const themes = activeThemes(allThemes);
const themeLabel = new Map(allThemes.map((theme) => [theme.id, theme.label]));
const entries = getVisibleEntries(process.cwd(), allThemes);

/** Sous-ensembles non vides des matières : chaque combinaison masque les entrées qui n'ont aucune matière cochée. */
function subsets(ids: string[]): string[][] {
  return ids.reduce<string[][]>(
    (all, id) => [...all, ...all.map((subset) => [...subset, id])],
    [[]],
  ).filter((subset) => subset.length > 0);
}

const filterCss = subsets(themes.map((theme) => theme.id))
  .map((unchecked) => {
    const conditions = unchecked.map((id) => `:has(#f-${id}:not(:checked))`).join("");
    const exclusions = themes
      .map((theme) => theme.id)
      .filter((id) => !unchecked.includes(id))
      .map((id) => `:not(.theme-${id})`)
      .join("");
    return `body${conditions} .entry${exclusions} { display: none; }`;
  })
  .join("\n");

/** Dates en français, à l'heure UTC : les mêmes au build comme en test. */
const dateFormat = new Intl.DateTimeFormat("fr-FR", { dateStyle: "long", timeZone: "UTC" });
const dayFormat = new Intl.DateTimeFormat("fr-FR", { day: "2-digit", timeZone: "UTC" });
const shortMonth = new Intl.DateTimeFormat("fr-FR", { month: "short", timeZone: "UTC" });

const latest = entries.find((entry) => entry.publishedAt !== null)?.publishedAt ?? null;
const count = `${entries.length} ${entries.length > 1 ? "publications" : "publication"}`;

/** Quatre teintes de façade, dont le béton : la quatrième casse l'alignement des colonnes. */
const CARD_COLORS = [
  { bg: "bg-red", text: "text-paper" },
  { bg: "bg-blue", text: "text-paper" },
  { bg: "bg-yellow", text: "text-ink" },
  { bg: "bg-concrete", text: "text-ink" },
];
---

<Base
  title="Veille — Vitrine"
  description="Les publications collectées, de la plus récente à la plus ancienne, chacune liée à sa source officielle."
  containerClass="max-w-[76rem]"
>
  <header class="max-w-2xl">
    <h1 class="mt-3 text-5xl sm:text-6xl">Veille_</h1>
    <p class="mt-5 text-muted">
      {count} collectées, chacune depuis sa source officielle, de la plus récente à la plus
      ancienne. Chaque titre renvoie à la publication officielle.
    </p>
    {
      latest !== null && (
        <p class="mt-3 font-mono text-[0.7rem] uppercase tracking-[0.12em] text-muted">
          Dernière publication : <time datetime={latest}>{dateFormat.format(new Date(latest))}</time>
        </p>
      )
    }
  </header>

  <section class="mt-10" aria-labelledby="matieres">
    <div class="flex items-end justify-between gap-4 border-b-2 border-ink pb-3">
      <h2 id="matieres" class="text-2xl sm:text-3xl">Matières</h2>
      <span class="font-mono text-[0.7rem] uppercase tracking-[0.12em] text-muted">
        Filtrer · {themes.length} active{themes.length > 1 ? "s" : ""}
      </span>
    </div>
    {
      themes.length === 0 ? (
        <p class="mt-6 text-muted">Aucune matière active. Activez-en une dans les paramètres locaux.</p>
      ) : (
        <>
          <div class="mt-4 flex flex-wrap gap-2" role="group" aria-label="Filtrer par matière">
            {themes.map((theme) => (
              <label class="theme-toggle">
                <input type="checkbox" id={`f-${theme.id}`} checked class="sr-only" />
                <span>{theme.label}</span>
              </label>
            ))}
          </div>
          <p class="mt-2 flex items-start gap-2 font-mono text-[0.7rem] uppercase tracking-[0.12em] text-muted">
            <span aria-hidden="true" class="inline-grid h-4 w-4 shrink-0 place-items-center border border-ink text-[0.6rem] leading-none">i</span>
            <span>Cochez une matière pour afficher ses publications ; décochez-la pour les masquer.</span>
          </p>
        </>
      )
    }
  </section>

  <input id="vue-grille" type="radio" name="vue" class="sr-only" checked />
  <input id="vue-liste" type="radio" name="vue" class="sr-only" />

  <div class="toolbar mt-8 flex items-center justify-between gap-4 border-t-2 border-ink pt-3">
    <p class="font-mono text-[0.7rem] uppercase tracking-[0.12em] text-muted">Affichage</p>
    <div class="inline-flex border-2 border-ink">
      <label
        for="vue-grille"
        class="grid h-11 w-11 cursor-pointer place-items-center bg-paper text-ink hover:bg-concrete"
      >
        <svg
          viewBox="0 0 16 16"
          class="h-4 w-4"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          aria-hidden="true"
        >
          <rect x="2" y="2" width="4.5" height="4.5"></rect>
          <rect x="9.5" y="2" width="4.5" height="4.5"></rect>
          <rect x="2" y="9.5" width="4.5" height="4.5"></rect>
          <rect x="9.5" y="9.5" width="4.5" height="4.5"></rect>
        </svg>
        <span class="sr-only">Vue grille</span>
      </label>
      <label
        for="vue-liste"
        class="grid h-11 w-11 cursor-pointer place-items-center border-l-2 border-ink bg-paper text-ink hover:bg-concrete"
      >
        <svg
          viewBox="0 0 16 16"
          class="h-4 w-4"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          aria-hidden="true"
        >
          <circle cx="3" cy="4" r="1" fill="currentColor"></circle>
          <circle cx="3" cy="8" r="1" fill="currentColor"></circle>
          <circle cx="3" cy="12" r="1" fill="currentColor"></circle>
          <path d="M7 4h7M7 8h7M7 12h7"></path>
        </svg>
        <span class="sr-only">Vue liste</span>
      </label>
    </div>
  </div>

  <div class="view-grid mt-8">
    <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        entries.map((entry, index) => {
          const summary =
            entry.summary !== null && !isRedundantSummary(entry.title, entry.summary)
              ? entry.summary
              : null;
          const color = CARD_COLORS[index % CARD_COLORS.length];
          const date = entry.publishedAt !== null ? new Date(entry.publishedAt) : null;
          return (
            <li class:list={["entry", ...entry.themes.map((theme) => `theme-${theme}`)]}>
              <a
                href={entry.url}
                aria-label={`${entry.title} — ${sourceLabel(entry.source)}`}
                class="flex h-full flex-col border-2 border-ink bg-paper no-underline hover:-translate-x-0.5 hover:-translate-y-0.5 hover:no-underline hover:shadow-hard"
              >
                <div
                  class:list={[
                    "flex items-end justify-between gap-3 border-b-2 border-ink px-4 pb-2 pt-3",
                    color.bg,
                    color.text,
                  ]}
                >
                  <span class="font-mono text-3xl font-bold leading-none">
                    {date !== null ? (
                      <time datetime={entry.publishedAt ?? undefined}>{dayFormat.format(date)}</time>
                    ) : (
                      "—"
                    )}
                  </span>
                  <span class="font-mono text-[0.7rem] uppercase tracking-[0.12em]">
                    {date !== null ? shortMonth.format(date) : "sans date"} · {sourceLabel(entry.source)}
                  </span>
                </div>
                <div class="flex flex-1 flex-col p-4">
                  <h2 class="text-lg leading-snug">{entry.title}</h2>
                  {summary !== null && (
                    <p class="mt-2 line-clamp-3 text-sm leading-relaxed text-muted">{summary}</p>
                  )}
                  {entry.references.length > 0 && (
                    <ul class="mt-3 flex flex-wrap gap-1.5">
                      {entry.references.map((reference) => (
                        <li class="border border-ink px-1.5 py-0.5 font-mono text-[0.7rem] leading-snug break-words">
                          {reference}
                        </li>
                      ))}
                    </ul>
                  )}
                  <ul class="mt-2 flex flex-wrap gap-1.5" aria-label="Matières">
                    {entry.themes.map((theme) => (
                      <li class="border-2 border-red px-1.5 py-0.5 font-mono text-[0.7rem] uppercase tracking-[0.12em] text-red">
                        {themeLabel.get(theme) ?? theme}
                      </li>
                    ))}
                  </ul>
                  <span class="mt-auto pt-4 font-mono text-[0.7rem] uppercase tracking-[0.12em] text-ink">
                    Lire ↗
                  </span>
                </div>
              </a>
            </li>
          );
        })
      }
    </ul>
  </div>

  <div class="view-list mx-auto mt-10 max-w-[56rem]">
    <ol class="border-t-2 border-ink">
      {
        entries.map((entry, index) => {
          const summary =
            entry.summary !== null && !isRedundantSummary(entry.title, entry.summary)
              ? entry.summary
              : null;
          const date = entry.publishedAt !== null ? new Date(entry.publishedAt) : null;
          return (
            <li class:list={["entry", "border-b-2", "border-ink", "hover:bg-paper", ...entry.themes.map((theme) => `theme-${theme}`)]}>
              <div class="grid grid-cols-[4.5rem_1fr] gap-4 py-5 sm:grid-cols-[3rem_6rem_1fr] sm:gap-6">
                <span class="hidden pt-1 font-mono text-xs text-muted sm:block">
                  {String(index + 1).padStart(2, "0")}
                </span>
                <div class="pt-1 font-mono">
                  {date !== null ? (
                    <time datetime={entry.publishedAt ?? undefined}>
                      <span class="block text-2xl font-bold leading-none">{dayFormat.format(date)}</span>
                      <span class="mt-1 block text-[0.7rem] uppercase tracking-[0.12em] text-muted">
                        {shortMonth.format(date)}
                      </span>
                    </time>
                  ) : (
                    <span class="text-xs text-muted">Sans date</span>
                  )}
                </div>
                <div>
                  <h2 class="text-lg leading-snug sm:text-xl">
                    <a
                      href={entry.url}
                      class="text-ink underline decoration-red decoration-2 underline-offset-4 hover:decoration-4"
                    >
                      {entry.title}
                    </a>
                  </h2>
                  {summary !== null && (
                    <p class="mt-2 line-clamp-2 text-sm leading-relaxed text-muted">{summary}</p>
                  )}
                  {entry.references.length > 0 && (
                    <ul class="mt-2 flex flex-wrap gap-1.5">
                      {entry.references.map((reference) => (
                        <li class="border border-ink px-1.5 py-0.5 font-mono text-[0.7rem] leading-snug break-words">
                          {reference}
                        </li>
                      ))}
                    </ul>
                  )}
                  <div class="mt-3 flex flex-wrap gap-1.5">
                    <p class="inline-block border-2 border-ink px-1.5 py-0.5 font-mono text-[0.7rem] uppercase tracking-[0.12em]">
                      {sourceLabel(entry.source)}
                    </p>
                    {entry.themes.map((theme) => (
                      <p class="inline-block border-2 border-red px-1.5 py-0.5 font-mono text-[0.7rem] uppercase tracking-[0.12em] text-red">
                        {themeLabel.get(theme) ?? theme}
                      </p>
                    ))}
                  </div>
                </div>
              </div>
            </li>
          );
        })
      }
    </ol>
  </div>
</Base>

<style>
  .view-grid,
  .view-list {
    display: none;
  }

  #vue-grille:checked ~ .view-grid,
  #vue-liste:checked ~ .view-list {
    display: block;
  }

  #vue-grille:checked ~ .toolbar label[for="vue-grille"],
  #vue-liste:checked ~ .toolbar label[for="vue-liste"] {
    background-color: var(--color-ink);
    color: var(--color-paper);
  }

  #vue-grille:focus-visible ~ .toolbar label[for="vue-grille"],
  #vue-liste:focus-visible ~ .toolbar label[for="vue-liste"] {
    outline: 2px solid var(--color-ink);
    outline-offset: 2px;
  }

  .theme-toggle span {
    display: inline-block;
    border: 2px solid var(--color-ink);
    background-color: var(--color-paper);
    padding: 0.55rem 0.75rem;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.7rem;
    line-height: 1;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    cursor: pointer;
  }

  .theme-toggle input:checked + span {
    background-color: var(--color-ink);
    color: var(--color-paper);
  }

  .theme-toggle input:focus-visible + span {
    outline: 2px solid var(--color-ink);
    outline-offset: 2px;
  }
</style>
<style is:global set:html={filterCss}></style>
