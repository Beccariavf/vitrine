---
import Legende from "../../components/Legende.astro";
import PublicationRangee from "../../components/PublicationRangee.astro";
import Base from "../../layouts/Base.astro";
import { getVisibleEntries, isRedundantSummary } from "../../lib/entries.ts";
import { familleDeSource } from "../../lib/familles.ts";
import { referenceLabel, referenceUrl } from "../../lib/references.ts";
import { sourceLabel } from "../../lib/sources.ts";
import { activeThemes, readThemes } from "../../../veille/themes.ts";

const allThemes = readThemes();
const themes = activeThemes(allThemes);
const themeLabel = new Map(allThemes.map((theme) => [theme.id, theme.label]));
const entries = getVisibleEntries(process.cwd(), allThemes);

/** Sous-ensembles non vides des matières : chaque combinaison masque les entrées qui n'ont aucune matière cochée. */
function subsets(ids: string[]): string[][] {
  return ids.reduce<string[][]>(
    (all, id) => [...all, ...all.map((subset) => [...subset, id])],
    [[]],
  ).filter((subset) => subset.length > 0);
}

const filterCss = subsets(themes.map((theme) => theme.id))
  .map((unchecked) => {
    const conditions = unchecked.map((id) => `:has(#f-${id}:not(:checked))`).join("");
    const exclusions = themes
      .map((theme) => theme.id)
      .filter((id) => !unchecked.includes(id))
      .map((id) => `:not(.theme-${id})`)
      .join("");
    return `body${conditions} .entry${exclusions} { display: none; }`;
  })
  .join("\n");

/** Dates en français, à l'heure UTC : les mêmes au build comme en test. */
const dateFormat = new Intl.DateTimeFormat("fr-FR", { dateStyle: "long", timeZone: "UTC" });
const dateCourte = new Intl.DateTimeFormat("fr-FR", {
  day: "numeric",
  month: "short",
  year: "numeric",
  timeZone: "UTC",
});

const latest = entries.find((entry) => entry.publishedAt !== null)?.publishedAt ?? null;
const count = `${entries.length} ${entries.length > 1 ? "publications" : "publication"}`;
---

<Base
  title="Veille — Vitrine"
  description="Les publications collectées, de la plus récente à la plus ancienne, chacune liée à sa source officielle."
  containerClass="max-w-[76rem]"
>
  <header class="max-w-2xl">
    <h1 class="text-5xl sm:text-6xl">Veille</h1>
    <p class="mt-5 text-encre-douce">
      {count} collectées, chacune depuis sa source officielle, de la plus récente à la plus
      ancienne. Chaque titre renvoie à la publication officielle.
    </p>
    {
      latest !== null && (
        <p class="mt-3 text-[0.8125rem] tabular-nums text-encre-douce">
          Dernière publication : <time datetime={latest}>{dateFormat.format(new Date(latest))}</time>
        </p>
      )
    }
    <Legende class="mt-5" />
  </header>

  <section class="mt-10" aria-labelledby="matieres">
    <div class="flex flex-wrap items-baseline justify-between gap-3 border-b border-filet pb-3">
      <h2 id="matieres" class="text-[0.8125rem] font-medium tracking-[0.04em] uppercase text-encre-douce">
        Matières
      </h2>
      <span class="text-[0.8125rem] text-encre-douce">
        Filtrer · {themes.length} active{themes.length > 1 ? "s" : ""}
      </span>
    </div>
    {
      themes.length === 0 ? (
        <p class="mt-6 text-encre-douce">Aucune matière active. Activez-en une dans les paramètres locaux.</p>
      ) : (
        <>
          <div class="mt-4 flex flex-wrap items-center gap-x-3 gap-y-2">
            <div class="flex flex-wrap items-center gap-2" role="group" aria-label="Filtrer par matière">
              {themes.map((theme) => (
                <label class="theme-toggle">
                  <input type="checkbox" id={`f-${theme.id}`} checked class="sr-only" />
                  <span>{theme.label}</span>
                </label>
              ))}
            </div>
            <p class="flex w-full items-start gap-2 text-[0.8125rem] text-encre-douce sm:ml-auto sm:w-auto">
              <span
                aria-hidden="true"
                class="mt-px inline-grid h-4 w-4 shrink-0 place-items-center rounded-[999px] border border-filet text-[0.6rem] leading-none"
              >
                i
              </span>
              <span>Cochez une matière pour afficher ses publications ; décochez-la pour les masquer.</span>
            </p>
          </div>
        </>
      )
    }
  </section>

  <input id="vue-grille" type="radio" name="vue" class="sr-only" checked />
  <input id="vue-liste" type="radio" name="vue" class="sr-only" />

  <div class="toolbar mt-8 flex items-center justify-between gap-4">
    <p class="text-[0.8125rem] font-medium text-encre-douce">Affichage</p>
    <div class="inline-flex gap-[2px] rounded-[999px] bg-surface p-[3px]">
      <label
        for="vue-grille"
        class="grid h-10 w-10 cursor-pointer place-items-center rounded-[999px] text-encre-douce transition-colors duration-200 hover:text-encre"
      >
        <svg
          viewBox="0 0 16 16"
          class="h-4 w-4"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          aria-hidden="true"
        >
          <rect x="2" y="2" width="4.5" height="4.5"></rect>
          <rect x="9.5" y="2" width="4.5" height="4.5"></rect>
          <rect x="2" y="9.5" width="4.5" height="4.5"></rect>
          <rect x="9.5" y="9.5" width="4.5" height="4.5"></rect>
        </svg>
        <span class="sr-only">Vue grille</span>
      </label>
      <label
        for="vue-liste"
        class="grid h-10 w-10 cursor-pointer place-items-center rounded-[999px] text-encre-douce transition-colors duration-200 hover:text-encre"
      >
        <svg
          viewBox="0 0 16 16"
          class="h-4 w-4"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          aria-hidden="true"
        >
          <circle cx="3" cy="4" r="1" fill="currentColor"></circle>
          <circle cx="3" cy="8" r="1" fill="currentColor"></circle>
          <circle cx="3" cy="12" r="1" fill="currentColor"></circle>
          <path d="M7 4h7M7 8h7M7 12h7"></path>
        </svg>
        <span class="sr-only">Vue liste</span>
      </label>
    </div>
  </div>

  <div class="view-grid mt-8">
    <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        entries.map((entry) => {
          const summary =
            entry.summary !== null && !isRedundantSummary(entry.title, entry.summary)
              ? entry.summary
              : null;
          const famille = familleDeSource(entry.source);
          const date = entry.publishedAt !== null ? new Date(entry.publishedAt) : null;
          return (
            <li class:list={["entry", ...entry.themes.map((theme) => `theme-${theme}`)]}>
              <article class="flex h-full flex-col rounded-bloc bg-surface p-6 transition-[transform,background-color,box-shadow] duration-200 hover:-translate-y-0.5 hover:bg-fond hover:shadow-douce">
                <div
                  data-source={entry.source}
                  data-famille={famille.id}
                  class="flex items-center justify-between gap-3 text-[0.8125rem] text-encre-douce"
                >
                  <span class="inline-flex items-center gap-1.5 font-medium text-encre">
                    <span
                      aria-hidden="true"
                      class:list={["inline-block h-[0.55rem] w-[0.55rem] shrink-0 rounded-[999px]", famille.classePastille]}
                    />
                    {sourceLabel(entry.source)}
                  </span>
                  <span class="tabular-nums">
                    {date !== null ? (
                      <time datetime={entry.publishedAt ?? undefined}>{dateCourte.format(date)}</time>
                    ) : (
                      "sans date"
                    )}
                  </span>
                </div>
                <h2 class="mt-4 font-serif text-[1.6rem] leading-[1.12] font-normal tracking-[-0.02em]">
                  <a
                    href={entry.url}
                    target="_blank"
                    rel="noopener"
                    aria-label={`${entry.title} — ${sourceLabel(entry.source)} (nouvel onglet)`}
                    class="text-encre no-underline hover:underline hover:decoration-1 hover:underline-offset-4"
                  >
                    {entry.title}
                  </a>
                </h2>
                {summary !== null && (
                  <p class="mt-3 line-clamp-3 text-[0.9375rem] leading-relaxed text-encre-douce">{summary}</p>
                )}
                {entry.references.length > 0 && (
                  <ul class="mt-4 flex flex-wrap gap-1.5">
                    {entry.references.map((reference) => {
                      const href = referenceUrl(reference);
                      return (
                        <li class="rounded-[8px] border border-filet px-2.5 py-1 text-[0.8125rem] leading-snug font-medium break-words hover:border-encre-douce">
                          {href === null ? (
                            <span title={reference}>{referenceLabel(reference)}</span>
                          ) : (
                            <a
                              href={href}
                              target="_blank"
                              rel="noopener"
                              title={reference}
                              class="text-encre no-underline hover:no-underline"
                            >
                              {referenceLabel(reference)}
                              <span class="sr-only"> (nouvel onglet)</span>
                            </a>
                          )}
                        </li>
                      );
                    })}
                  </ul>
                )}
                <ul class="mt-2 flex flex-wrap gap-1.5" aria-label="Matières">
                  {entry.themes.map((theme) => (
                    <li class="rounded-[999px] bg-accent/10 px-2.5 py-1 text-[0.75rem] font-medium">
                      {themeLabel.get(theme) ?? theme}
                    </li>
                  ))}
                </ul>
                <a
                  href={entry.url}
                  target="_blank"
                  rel="noopener"
                  aria-label={`Lire : ${entry.title} — ${sourceLabel(entry.source)} (nouvel onglet)`}
                  class="mt-auto pt-4 text-[0.9375rem] font-medium text-encre no-underline hover:underline hover:decoration-1 hover:underline-offset-4"
                >
                  Lire ↗
                </a>
              </article>
            </li>
          );
        })
      }
    </ul>
  </div>

  <div class="view-list mx-auto mt-10 max-w-[56rem]">
    <ol>
      {
        entries.map((entry) => (
          <PublicationRangee
            entry={entry}
            variante="complete"
            niveau="h2"
            matieres={themeLabel}
            class={["entry", ...entry.themes.map((theme) => `theme-${theme}`)].join(" ")}
          />
        ))
      }
    </ol>
  </div>
</Base>

<style>
  .view-grid,
  .view-list {
    display: none;
  }

  #vue-grille:checked ~ .view-grid,
  #vue-liste:checked ~ .view-list {
    display: block;
  }

  #vue-grille:checked ~ .toolbar label[for="vue-grille"],
  #vue-liste:checked ~ .toolbar label[for="vue-liste"] {
    background-color: var(--color-fond);
    color: var(--color-encre);
    box-shadow: var(--shadow-douce);
  }

  #vue-grille:focus-visible ~ .toolbar label[for="vue-grille"],
  #vue-liste:focus-visible ~ .toolbar label[for="vue-liste"] {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  .theme-toggle span {
    display: inline-block;
    border: 1px solid var(--color-filet);
    border-radius: 999px;
    background-color: transparent;
    padding: 0.5rem 0.9rem;
    font-size: 0.8125rem;
    font-weight: 500;
    line-height: 1.1;
    color: var(--color-encre-douce);
    cursor: pointer;
    transition:
      background-color 0.2s ease,
      border-color 0.2s ease,
      color 0.2s ease;
  }

  .theme-toggle span:hover {
    border-color: var(--color-encre-douce);
  }

  .theme-toggle input:checked + span {
    border-color: transparent;
    background-color: color-mix(in srgb, var(--color-accent) 10%, transparent);
    color: var(--color-encre);
  }

  .theme-toggle input:focus-visible + span {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  @media (max-width: 640px) {
    .theme-toggle span {
      padding: 0.45rem 0.7rem;
      font-size: 0.75rem;
    }
  }
</style>
<style is:global set:html={filterCss}></style>
