---
import Demo from "../components/Demo.astro";
import EssaiRecherche from "../components/EssaiRecherche.astro";
import Facade from "../components/Facade.astro";
import Base from "../layouts/Base.astro";
import { sourcesCorpus } from "../lib/corpus.ts";
import { lireDemo } from "../lib/demo.ts";
import {
  CHAMPS_GOUVERNANCE,
  LIBELLES_GOUVERNANCE,
  corpusDeclare,
  corpusDuChamp,
} from "../../mcp/corpus/registre.ts";

const sources = sourcesCorpus();
const demo = lireDemo();

/** Table corpus → champs, dérivée du registre : aucune liste recopiée ici. */
const champsGouvernance = CHAMPS_GOUVERNANCE.map((champ) => ({
  champ,
  libelle: LIBELLES_GOUVERNANCE[champ],
  corpus: corpusDuChamp(champ).map((nom) => corpusDeclare(nom)?.libelle ?? nom),
}));

/** Dates en français, à l'heure UTC : les mêmes au build comme en test. */
const dateFormat = new Intl.DateTimeFormat("fr-FR", { dateStyle: "long", timeZone: "UTC" });
const nombre = new Intl.NumberFormat("fr-FR");

const etapes = [
  {
    numero: "01",
    titre: "Ajoutez le connecteur",
    texte: "Le connecteur se branche sur votre assistant comme un serveur MCP : vos conversations restent dans votre outil.",
  },
  {
    numero: "02",
    titre: "Posez votre question",
    texte: "Interrogez votre IA comme d'habitude : elle va chercher dans les textes, les autorités et les juridictions du droit des données personnelles.",
  },
  {
    numero: "03",
    titre: "Vérifiez la source",
    texte: "Les passages retrouvés portent leur référence et leur lien vers le texte officiel : vous vérifiez avant de vous appuyer dessus.",
  },
];

/** Titre de section de la page : sans 500 serré, la hiérarchie vient de la taille. */
const titreSection = "text-[clamp(1.75rem,3.2vw,2.5rem)] leading-[1.1] font-medium tracking-[-0.025em]";
---

<Base
  title="Connecteur — Vitrine"
  description="Un connecteur en préparation entre votre IA et les sources officielles du droit des données personnelles : ce qu'il couvre, comment il est construit."
>
  <section>
    <p class="inline-flex items-center gap-2 text-[0.8125rem] font-medium text-encre-douce">
      <span aria-hidden="true" class="inline-block h-1.5 w-1.5 rounded-[999px] bg-accent"></span>
      En préparation
    </p>
    <h1 class="mt-6 max-w-4xl text-[clamp(2.75rem,7vw,5.25rem)]">
      Votre IA, appuyée sur les sources officielles du droit des données personnelles.
    </h1>
    <p class="mt-6 max-w-2xl text-[1.125rem] leading-relaxed text-encre-douce text-pretty">
      Le connecteur relie votre assistant aux textes, aux décisions des autorités et à la
      jurisprudence en matière de données personnelles. Il est en préparation : cette page décrit ce
      qu'il couvre aujourd'hui et comment il est construit.
    </p>
  </section>

  {
    demo !== null && (
      <section aria-label="Démonstration" class="mt-16 sm:mt-24">
        <Demo demo={demo} variante="complete" />
      </section>
    )
  }

  <EssaiRecherche />

  <section aria-labelledby="fonctionnement" class="espace-section">
    <h2 id="fonctionnement" class={titreSection}>Comment ça marche</h2>
    <ol class="mt-8 grid gap-4 sm:grid-cols-3">
      {
        etapes.map((etape) => (
          <li class="rounded-bloc bg-surface p-6 sm:p-8">
            <span aria-hidden="true" class="block font-serif text-6xl leading-none tabular-nums text-encre-douce">
              {etape.numero}
            </span>
            <h3 class="mt-4 text-2xl">{etape.titre}</h3>
            <p class="mt-2 text-[0.9375rem] leading-relaxed text-encre-douce text-pretty">{etape.texte}</p>
          </li>
        ))
      }
    </ol>
  </section>

  <section aria-labelledby="couverture" class="espace-section">
    <h2 id="couverture" class={titreSection}>Ce que couvre la base</h2>
    <Facade sources={sources} class="mt-8" />
    <div class="mt-8 overflow-x-auto rounded-bloc border border-filet bg-surface">
      <table class="w-full border-collapse text-left">
        <thead>
          <tr class="border-b border-filet text-[0.75rem] font-medium tracking-[0.04em] uppercase text-encre-douce">
            <th scope="col" class="px-3 py-3 font-medium sm:px-6">Collection</th>
            <th scope="col" class="px-3 py-3 text-right font-medium sm:px-6">Documents</th>
            <th scope="col" class="px-3 py-3 font-medium sm:px-6">À jour au</th>
          </tr>
        </thead>
        <tbody>
          {
            sources.map((source) => (
              <tr data-collection class="border-b border-filet last:border-b-0">
                <th scope="row" class="px-3 py-3 text-sm font-medium sm:px-6">{source.libelle}</th>
                <td class="px-3 py-3 text-right text-sm tabular-nums sm:px-6">
                  {nombre.format(source.documents)}
                </td>
                <td class="px-3 py-3 text-sm tabular-nums sm:px-6">
                  {source.arrete_le !== null ? (
                    <time datetime={source.arrete_le}>{dateFormat.format(new Date(source.arrete_le))}</time>
                  ) : (
                    "texte consolidé"
                  )}
                </td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
    <h3 class="mt-10 text-2xl">Champs de gouvernance</h3>
    <div class="mt-4 overflow-x-auto rounded-bloc border border-filet bg-surface">
      <table class="w-full border-collapse text-left">
        <caption class="sr-only">
          Champs de gouvernance couverts et collections qui en relèvent
        </caption>
        <thead>
          <tr class="border-b border-filet text-[0.75rem] font-medium tracking-[0.04em] uppercase text-encre-douce">
            <th scope="col" class="px-3 py-3 font-medium sm:px-6">Champ</th>
            <th scope="col" class="px-3 py-3 font-medium sm:px-6">Collections</th>
          </tr>
        </thead>
        <tbody>
          {
            champsGouvernance.map(({ champ, libelle, corpus }) => (
              <tr data-gouvernance={champ} class="border-b border-filet last:border-b-0">
                <th scope="row" class="px-3 py-3 text-sm font-medium first-letter:uppercase sm:px-6">
                  {libelle}
                </th>
                <td class="px-3 py-3 text-sm leading-relaxed text-encre-douce sm:px-6">
                  {corpus.join(" · ")}
                </td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
    <p class="mt-4 max-w-2xl text-[0.9375rem] leading-relaxed text-encre-douce">
      Une collection peut relever de plusieurs champs : cette correspondance est celle du serveur.
    </p>
  </section>

  <section aria-labelledby="construction" class="espace-section">
    <h2 id="construction" class={titreSection}>Comment c'est construit</h2>
    <div class="mt-8 overflow-hidden rounded-bloc bg-accent text-sur-accent shadow-douce">
      <div
        class="flex items-center justify-between border-b border-sur-accent/20 px-5 py-3 font-mono text-[0.7rem] uppercase tracking-[0.14em] sm:px-6"
      >
        <span>pipeline.log</span>
        <span class="text-sur-accent">lecture seule</span>
      </div>
      <div class="overflow-x-auto p-5 font-mono text-xs leading-relaxed sm:p-6 sm:text-sm">
        <p><span class="text-sur-accent">$</span> npm run corpus:sync</p>
        <p class="text-sur-accent">→ entrées récentes de la veille → sources officielles → index → data/corpus/sync.json</p>
        <p class="mt-3"><span class="text-sur-accent">$</span> npm run preparation:sync</p>
        <p class="text-sur-accent">→ instantané séparé : textes en préparation et affaires pendantes</p>
        <p class="mt-3"><span class="text-sur-accent">$</span> npm run mcp</p>
        <p class="text-sur-accent">→ serveur MCP : get_article · get_decision · search · etat_corpus</p>
      </div>
    </div>
  </section>

  <section aria-labelledby="transparence" class="espace-section">
    <h2 id="transparence" class={titreSection}>Transparence</h2>
    <p class="mt-6 max-w-2xl leading-relaxed">
      Le code et le corpus sont ouverts : vous pouvez lire comment chaque source est collectée et
      découpée.
    </p>
    <a
      href="https://github.com/Beccariavf/vitrine"
      class="mt-4 inline-flex items-center gap-2 border-b border-filet pb-0.5 text-[0.9375rem] font-medium no-underline hover:border-encre hover:no-underline"
    >
      Voir le dépôt GitHub <span aria-hidden="true">→</span>
    </a>
  </section>

  <section aria-labelledby="suite" class="espace-section border-t border-filet pt-12">
    <h2 id="suite" class={titreSection}>En attendant le connecteur</h2>
    <p class="mt-4 max-w-2xl leading-relaxed text-encre-douce">
      La veille suit déjà les publications des autorités et juridictions du numérique, chacune liée à son texte officiel.
    </p>
    <div class="mt-6 flex flex-col items-stretch sm:flex-row">
      <a
        href="/veille"
        class="inline-flex items-center justify-center gap-2 rounded-[999px] bg-accent px-6 py-3.5 text-[0.9375rem] font-medium text-sur-accent no-underline transition-transform duration-200 hover:-translate-y-px hover:no-underline"
      >
        Consulter la veille <span aria-hidden="true">→</span>
      </a>
    </div>
    <p class="mt-6 max-w-2xl text-[0.875rem] text-encre-douce">
      Outil d'aide à la recherche, ne remplace pas l'analyse d'un professionnel du droit.
    </p>
  </section>
</Base>
