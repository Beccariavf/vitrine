---
import ChiffresCorpus from "../components/ChiffresCorpus.astro";
import Demo from "../components/Demo.astro";
import EssaiRecherche from "../components/EssaiRecherche.astro";
import Legende from "../components/Legende.astro";
import RangeeFamille from "../components/RangeeFamille.astro";
import Base from "../layouts/Base.astro";
import { resumeCorpus, sourcesCorpus } from "../lib/corpus.ts";
import { lireDemo } from "../lib/demo.ts";
import {
  CHAMPS_GOUVERNANCE,
  LIBELLES_GOUVERNANCE,
  NOMS_SITE,
  corpusDeclare,
  corpusDuChamp,
} from "../../mcp/corpus/registre.ts";

const sources = sourcesCorpus();
const resume = resumeCorpus(sources);
const demo = lireDemo();

/** Table corpus → champs, dérivée du registre : aucune liste recopiée ici. */
const RANG_SITE = new Map(NOMS_SITE.map((nom, index) => [nom, index]));
const champsGouvernance = CHAMPS_GOUVERNANCE.map((champ) => ({
  champ,
  libelle: LIBELLES_GOUVERNANCE[champ],
  corpus: corpusDuChamp(champ)
    .sort(
      (gauche, droite) =>
        (RANG_SITE.get(gauche) ?? NOMS_SITE.length) - (RANG_SITE.get(droite) ?? NOMS_SITE.length),
    )
    .map((nom) => corpusDeclare(nom)?.libelle ?? nom),
}));

/** Dates en français, à l'heure UTC : les mêmes au build comme en test. */
const dateFormat = new Intl.DateTimeFormat("fr-FR", { dateStyle: "long", timeZone: "UTC" });
const nombre = new Intl.NumberFormat("fr-FR");

const etapes = [
  {
    numero: "01",
    titre: "Ajoutez le connecteur",
    texte: "Le connecteur se branche sur votre assistant comme un serveur MCP : vos conversations restent dans votre outil.",
  },
  {
    numero: "02",
    titre: "Posez votre question",
    texte: "Interrogez votre IA comme d'habitude : elle va chercher dans les textes, les autorités et les juridictions du droit des données personnelles.",
  },
  {
    numero: "03",
    titre: "Vérifiez la source",
    texte: "Les passages retrouvés portent leur référence et leur lien vers le texte officiel : vous vérifiez avant de vous appuyer dessus.",
  },
];

/** Trois points de méthode, chacun court : ils complètent le lien du dépôt. */
const pointsOuverts = [
  "Sources officielles uniquement : chaque collection vient de son site officiel.",
  "Chaque passage garde son lien vers le texte d'origine.",
  "Chaque collection porte sa date de mise à jour, ou la mention « texte consolidé ».",
];

/** Titre de section de la page : sans 500 serré, la hiérarchie vient de la taille. */
const titreSection = "text-[clamp(1.75rem,3.2vw,2.5rem)] leading-[1.1] font-medium tracking-[-0.025em]";
---

<Base
  title="Connecteur — Vitrine"
  description="Un connecteur en préparation entre votre IA et les sources officielles du droit des données personnelles : ce qu'il couvre, comment il est construit."
>
  <section class="hero grid justify-items-center gap-8 px-1 pb-2 pt-10 text-center sm:gap-10 sm:pt-[6rem]">
    <p class="inline-flex items-center gap-2 text-[0.8125rem] font-medium text-encre-douce">
      <span aria-hidden="true" class="inline-block h-1.5 w-1.5 rounded-[999px] bg-accent"></span>
      En préparation
    </p>
    <h1 class="max-w-[16ch] text-[clamp(3rem,8vw,6rem)] leading-[0.98] tracking-[-0.02em]">
      {nombre.format(resume.documents)} décisions et textes officiels. Une seule question.
    </h1>
    <p class="max-w-[38rem] text-[clamp(1.125rem,2vw,1.375rem)] leading-[1.5] text-pretty text-encre-douce">
      Le connecteur relie votre IA aux textes, aux autorités et aux juridictions du droit des données.
      Chaque réponse cite sa source officielle.
    </p>

    <div class="flex flex-wrap items-center justify-center gap-3">
      <a
        href="#essai-recherche"
        class="inline-flex items-center justify-center gap-2 rounded-[999px] bg-accent px-6 py-4 text-[0.9375rem] font-medium leading-none tracking-[-0.01em] text-sur-accent no-underline transition-transform duration-200 hover:-translate-y-px hover:no-underline"
      >
        Essayer la recherche <span aria-hidden="true">→</span>
      </a>
      <a
        href="/veille"
        class="inline-flex items-center justify-center rounded-[999px] bg-accent/10 px-6 py-4 text-[0.9375rem] font-medium leading-none tracking-[-0.01em] text-encre no-underline transition-colors duration-200 hover:bg-accent/15 hover:no-underline"
      >
        Consulter la veille
      </a>
    </div>

    {
      demo !== null && (
        <div class="w-full max-w-[46rem] pt-7 text-left">
          <Demo demo={demo} variante="compacte" />
        </div>
      )
    }
  </section>

  <ChiffresCorpus resume={resume} />

  {
    demo !== null && (
      <section aria-label="Démonstration" class="mt-16 sm:mt-[6rem]">
        <Demo demo={demo} variante="complete" />
      </section>
    )
  }

  <section aria-labelledby="couverture" class="espace-section">
    <h2 id="couverture" class="sr-only">Ce que couvre la base</h2>
    <div class="grid gap-16 sm:gap-20">
      {resume.familles.map((famille, rang) => <RangeeFamille famille={famille} rang={rang} />)}
    </div>
  </section>

  <section aria-labelledby="champs" class="espace-section">
    <h2 id="champs" class={titreSection}>Quatre champs, une base.</h2>
    <div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {
        champsGouvernance.map(({ champ, libelle, corpus }) => (
          <div data-gouvernance={champ} class="rounded-bloc bg-surface p-6">
            <h3 class="font-serif text-3xl font-normal first-letter:uppercase">{libelle}</h3>
            <p class="mt-5 text-[2.5rem] leading-none font-medium tabular-nums">
              {nombre.format(corpus.length)}
              <span class="text-[0.9375rem] font-normal tracking-normal text-encre-douce"> collections</span>
            </p>
            <p class="mt-5 text-[0.8125rem] leading-relaxed text-encre-douce">{corpus.join(" · ")}</p>
          </div>
        ))
      }
    </div>
    <p class="mt-8 max-w-2xl text-[0.9375rem] leading-relaxed text-encre-douce">
      Une collection peut relever de plusieurs champs : cette correspondance est celle du serveur.
      Le connecteur reste centré sur les données personnelles et couvre les autres champs par les
      textes, la doctrine et le contentieux déjà au corpus.
    </p>

    <details class="mt-12">
      <summary
        class="inline-flex cursor-pointer list-none items-center gap-2 rounded-[999px] bg-accent/10 px-5 py-3 text-[0.9375rem] font-medium text-encre transition-colors duration-200 hover:bg-accent/15 [&::-webkit-details-marker]:hidden"
      >
        Voir le détail des {nombre.format(resume.collections)} collections
      </summary>
      <div class="mt-8 overflow-x-auto rounded-bloc border border-filet bg-surface">
        <table class="w-full border-collapse text-left">
          <thead>
            <tr class="border-b border-filet text-[0.75rem] font-medium tracking-[0.04em] uppercase text-encre-douce">
              <th scope="col" class="px-3 py-3 font-medium sm:px-6">Collection</th>
              <th scope="col" class="px-3 py-3 text-right font-medium sm:px-6">Documents</th>
              <th scope="col" class="px-3 py-3 font-medium sm:px-6">À jour au</th>
            </tr>
          </thead>
          <tbody>
            {
              sources.map((source) => (
                <tr data-collection class="border-b border-filet last:border-b-0">
                  <th scope="row" class="px-3 py-3 text-sm font-medium sm:px-6">{source.libelle}</th>
                  <td class="px-3 py-3 text-right text-sm tabular-nums sm:px-6">
                    {nombre.format(source.documents)}
                  </td>
                  <td class="px-3 py-3 text-sm tabular-nums sm:px-6">
                    {source.arrete_le !== null ? (
                      <time datetime={source.arrete_le}>{dateFormat.format(new Date(source.arrete_le))}</time>
                    ) : (
                      "texte consolidé"
                    )}
                  </td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
      <Legende class="mt-6" />
    </details>
  </section>

  <EssaiRecherche />

  <section aria-labelledby="fonctionnement" class="espace-section">
    <h2 id="fonctionnement" class={titreSection}>Comment ça marche</h2>
    <ol class="mt-10 grid gap-10 sm:grid-cols-3 sm:gap-8">
      {
        etapes.map((etape) => (
          <li class="border-t border-filet pt-6">
            <span aria-hidden="true" class="block font-serif text-7xl leading-none tabular-nums text-encre-douce">
              {etape.numero}
            </span>
            <h3 class="mt-4 text-2xl">{etape.titre}</h3>
            <p class="mt-2 text-[0.9375rem] leading-relaxed text-encre-douce text-pretty">{etape.texte}</p>
          </li>
        ))
      }
    </ol>
  </section>

  <section aria-labelledby="ouvert" class="espace-section grid gap-10 md:grid-cols-2 md:items-center md:gap-16">
    <div>
      <h2 id="ouvert" class={titreSection}>Ouvert et vérifiable.</h2>
      <p class="mt-6 max-w-[34rem] text-[1.0625rem] leading-relaxed text-encre-douce">
        Le code, le corpus et la méthode sont publics : chaque source est collectée depuis son site
        officiel, découpée et datée.
      </p>
      <a href="https://github.com/Beccariavf/vitrine" class="lien mt-6 inline-block">
        Voir le dépôt GitHub <span aria-hidden="true">→</span>
      </a>
    </div>
    <ul class="grid gap-5">
      {
        pointsOuverts.map((point) => (
          <li class="flex gap-3 text-[1rem] leading-relaxed">
            <span
              aria-hidden="true"
              class="mt-[0.6em] inline-block h-1.5 w-1.5 shrink-0 rounded-[999px] bg-accent"
            />
            <span class="min-w-0">{point}</span>
          </li>
        ))
      }
    </ul>
  </section>

  <section aria-labelledby="appel" class="ecran-appel espace-section">
    <div class="grid justify-items-center gap-8">
      <h2
        id="appel"
        class="max-w-[18ch] font-serif text-[clamp(2.5rem,6.5vw,5rem)] leading-[0.98] font-normal tracking-[-0.02em]"
      >
        Votre IA, appuyée sur le droit.
      </h2>
      <p class="max-w-[34rem] text-[clamp(1.125rem,2vw,1.375rem)] leading-[1.5] text-pretty text-encre-douce">
        Le connecteur est en préparation. En attendant, la veille suit chaque publication officielle.
      </p>
      <div class="flex flex-wrap items-center justify-center gap-3">
        <a
          href="/veille"
          class="inline-flex items-center justify-center gap-2 rounded-[999px] bg-accent px-6 py-4 text-[0.9375rem] font-medium leading-none tracking-[-0.01em] text-sur-accent no-underline transition-transform duration-200 hover:-translate-y-px hover:no-underline"
        >
          Consulter la veille <span aria-hidden="true">→</span>
        </a>
        <a
          href="https://github.com/Beccariavf/vitrine"
          class="inline-flex items-center justify-center rounded-[999px] bg-accent/10 px-6 py-4 text-[0.9375rem] font-medium leading-none tracking-[-0.01em] text-encre no-underline transition-colors duration-200 hover:bg-accent/15 hover:no-underline"
        >
          Voir le dépôt
        </a>
      </div>
      <p class="max-w-[34rem] text-[0.875rem] text-encre-douce">
        Outil d'aide à la recherche, ne remplace pas l'analyse d'un professionnel du droit.
      </p>
    </div>
  </section>
</Base>

<style>
  .hero > * {
    animation: monte 0.8s cubic-bezier(0.2, 0.7, 0.2, 1) both;
  }

  .hero > *:nth-child(2) {
    animation-delay: 0.06s;
  }

  .hero > *:nth-child(3) {
    animation-delay: 0.14s;
  }

  .hero > *:nth-child(4) {
    animation-delay: 0.22s;
  }

  .hero > *:nth-child(5) {
    animation-delay: 0.3s;
  }

  @keyframes monte {
    from {
      opacity: 0.35;
      transform: translateY(10px);
    }

    to {
      opacity: 1;
      transform: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero > * {
      animation: none;
    }
  }

  /* Appel final : un écran plus court, centré, comme le manifeste de l'accueil. */
  .ecran-appel {
    display: grid;
    place-items: center;
    min-height: 70vh;
    min-height: 70svh;
    text-align: center;
  }

  /* Lien de section : un filet fin, pas de soulignement. */
  .lien {
    border-bottom: 1px solid var(--color-filet);
    padding-bottom: 2px;
    font-size: 0.9375rem;
    font-weight: 500;
    text-decoration: none;
  }

  .lien:hover {
    border-color: var(--color-encre);
    text-decoration: none;
  }
</style>
