---
import Demo from "../components/Demo.astro";
import Facade from "../components/Facade.astro";
import Base from "../layouts/Base.astro";
import { sourcesCorpus } from "../lib/corpus.ts";
import { lireDemo } from "../lib/demo.ts";

const sources = sourcesCorpus();
const demo = lireDemo();

/** Dates en français, à l'heure UTC : les mêmes au build comme en test. */
const dateFormat = new Intl.DateTimeFormat("fr-FR", { dateStyle: "long", timeZone: "UTC" });
const nombre = new Intl.NumberFormat("fr-FR");

const etapes = [
  {
    numero: "01",
    couleur: "bg-blue text-paper",
    titre: "Ajoutez le connecteur",
    texte: "Le connecteur se branche sur votre assistant comme un serveur MCP : vos conversations restent dans votre outil.",
  },
  {
    numero: "02",
    couleur: "bg-red text-paper",
    titre: "Posez votre question",
    texte: "Interrogez votre IA comme d'habitude : elle va chercher dans les textes, les autorités et les juridictions du droit des données personnelles.",
  },
  {
    numero: "03",
    couleur: "bg-yellow text-ink",
    titre: "Vérifiez la source",
    texte: "Les passages retrouvés portent leur référence et leur lien vers le texte officiel : vous vérifiez avant de vous appuyer dessus.",
  },
];
---

<Base
  title="Connecteur — Vitrine"
  description="Un connecteur en préparation entre votre IA et les sources officielles du droit des données personnelles : ce qu'il couvre, comment il est construit."
>
  <section>
    <p class="font-mono text-[0.7rem] uppercase tracking-[0.14em] text-muted">En préparation</p>
    <h1 class="mt-6 max-w-4xl text-4xl sm:text-5xl lg:text-6xl">
      Votre IA, appuyée sur les sources officielles du droit des données personnelles.
    </h1>
    <p class="mt-6 max-w-2xl text-lg leading-relaxed text-muted text-pretty">
      Le connecteur relie votre assistant aux textes, aux décisions des autorités et à la
      jurisprudence en matière de données personnelles. Il est en préparation : cette page décrit ce
      qu'il couvre aujourd'hui et comment il est construit.
    </p>
  </section>

  {
    demo !== null && (
      <section aria-label="Démonstration" class="mt-14">
        <Demo demo={demo} variante="complete" />
      </section>
    )
  }

  <section aria-labelledby="fonctionnement" class="mt-20">
    <h2 id="fonctionnement" class="text-3xl sm:text-4xl">Comment ça marche</h2>
    <ol class="mt-8 grid border-2 border-ink bg-paper shadow-hard sm:grid-cols-3">
      {
        etapes.map((etape, index) => (
          <li class:list={["p-5 sm:p-6", index > 0 && "border-t-2 border-ink sm:border-t-0 sm:border-l-2"]}>
            <span aria-hidden="true" class:list={["etape-numero", etape.couleur]}>
              {etape.numero}
            </span>
            <h3 class="mt-4 text-2xl">{etape.titre}</h3>
            <p class="mt-2 text-sm leading-relaxed text-muted text-pretty">{etape.texte}</p>
          </li>
        ))
      }
    </ol>
  </section>

  <section aria-labelledby="couverture" class="mt-20">
    <div class="border-b-2 border-ink pb-3">
      <h2 id="couverture" class="text-3xl sm:text-4xl">Ce que couvre la base</h2>
    </div>
    <Facade sources={sources} class="mt-8" />
    <div class="mt-8 border-2 border-ink bg-paper shadow-hard">
      <table class="w-full border-collapse text-left">
        <thead>
          <tr class="border-b-2 border-ink font-mono text-[0.7rem] uppercase tracking-[0.12em] text-muted">
            <th scope="col" class="px-3 py-2 font-normal sm:px-4">Collection</th>
            <th scope="col" class="px-3 py-2 text-right font-normal sm:px-4">Documents</th>
            <th scope="col" class="px-3 py-2 font-normal sm:px-4">À jour au</th>
          </tr>
        </thead>
        <tbody>
          {
            sources.map((source) => (
              <tr data-collection class="border-b border-ink last:border-b-0">
                <th scope="row" class="px-3 py-2 text-sm font-bold sm:px-4">{source.libelle}</th>
                <td class="px-3 py-2 text-right font-mono text-sm tabular-nums sm:px-4">
                  {nombre.format(source.documents)}
                </td>
                <td class="px-3 py-2 font-mono text-xs sm:px-4">
                  {source.arrete_le !== null ? (
                    <time datetime={source.arrete_le}>{dateFormat.format(new Date(source.arrete_le))}</time>
                  ) : (
                    "texte consolidé"
                  )}
                </td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
    <p class="mt-4 max-w-2xl text-sm leading-relaxed text-muted">
      La base couvre le droit des données personnelles et l'AI Act : ni les autres matières du
      numérique, ni la doctrine privée.
    </p>
  </section>

  <section aria-labelledby="construction" class="mt-20">
    <div class="border-b-2 border-ink pb-3">
      <h2 id="construction" class="text-3xl sm:text-4xl">Comment c'est construit</h2>
    </div>
    <div class="mt-8 border-2 border-ink bg-ink text-paper shadow-hard">
      <div
        class="flex items-center justify-between border-b-2 border-paper/20 px-4 py-2 font-mono text-[0.7rem] uppercase tracking-[0.14em]"
      >
        <span>pipeline.log</span>
        <span class="text-paper/60">lecture seule</span>
      </div>
      <div class="overflow-x-auto p-4 font-mono text-xs leading-relaxed sm:p-6 sm:text-sm">
        <p><span class="text-yellow">$</span> npm run corpus:sync</p>
        <p class="text-paper/70">→ entrées récentes de la veille → sources officielles → index → data/corpus/sync.json</p>
        <p class="mt-3"><span class="text-yellow">$</span> npm run mcp</p>
        <p class="text-paper/70">→ serveur MCP : get_article · get_decision · search · etat_corpus</p>
      </div>
    </div>
  </section>

  <section aria-labelledby="transparence" class="mt-20">
    <div class="border-b-2 border-ink pb-3">
      <h2 id="transparence" class="text-3xl sm:text-4xl">Transparence</h2>
    </div>
    <p class="mt-6 max-w-2xl leading-relaxed">
      Le code et le corpus sont ouverts : vous pouvez lire comment chaque source est collectée et
      découpée.
    </p>
    <a
      href="https://github.com/Beccariavf/vitrine"
      class="mt-4 inline-flex items-center gap-2 font-mono text-[0.7rem] uppercase tracking-[0.12em] text-ink"
    >
      Voir le dépôt GitHub <span aria-hidden="true">→</span>
    </a>
  </section>

  <section aria-labelledby="suite" class="mt-20 border-t-2 border-ink pt-8">
    <h2 id="suite" class="text-3xl sm:text-4xl">En attendant le connecteur</h2>
    <p class="mt-4 max-w-2xl leading-relaxed text-muted">
      La veille suit déjà les publications des autorités et juridictions du numérique, chacune liée à son texte officiel.
    </p>
    <div class="mt-6 flex flex-col items-stretch sm:flex-row">
      <a
        href="/veille"
        class="inline-flex items-center justify-center gap-2 border-2 border-ink bg-ink px-5 py-3 font-mono text-[0.7rem] font-bold uppercase tracking-[0.12em] text-paper no-underline shadow-hard hover:-translate-x-0.5 hover:-translate-y-0.5 hover:bg-red hover:no-underline hover:shadow-hard-lg"
      >
        Consulter la veille <span aria-hidden="true">→</span>
      </a>
    </div>
    <p class="mt-6 max-w-2xl text-sm text-muted">
      Outil d'aide à la recherche, ne remplace pas l'analyse d'un professionnel du droit.
    </p>
  </section>
</Base>

<style>
  /* Plaque brute : aplat de famille, cadre encre, ombre dure, chiffre mono. L'ordre est porté par la liste ordonnée. */
  .etape-numero {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 5rem;
    height: 5rem;
    border: 3px solid var(--color-ink);
    box-shadow: 6px 6px 0 var(--color-ink);
    font-family: var(--font-mono);
    font-size: 2.6rem;
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.04em;
    font-variant-numeric: tabular-nums;
  }
</style>
