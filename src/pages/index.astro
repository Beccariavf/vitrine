---
import Base from "../layouts/Base.astro";
import { getEntries } from "../lib/entries.ts";

const entries = getEntries();
const sources = new Set(entries.map((entry) => entry.source)).size;

const products = [
  {
    title: "Veille active",
    body: "Les actualités de la CNIL, collectées depuis le flux officiel et publiées en statique, de la plus récente à la plus ancienne.",
    link: "/veille",
    status: "Disponible",
  },
  {
    title: "MCP",
    body: "Un serveur MCP pour interroger le même corpus depuis un assistant, sans quitter la conversation.",
    link: null,
    status: "À venir",
  },
  {
    title: "Plugin",
    body: "Un plugin pour consulter la veille et préparer une note sans quitter l'outil de travail.",
    link: null,
    status: "À venir",
  },
];

const steps = [
  {
    number: "01",
    title: "Collecte",
    body: "Le flux officiel de la CNIL est lu une fois par passe. La réponse brute est conservée telle quelle.",
  },
  {
    number: "02",
    title: "Normalisation",
    body: "Chaque actualité reçoit un identifiant stable, une URL canonique et une date en UTC.",
  },
  {
    number: "03",
    title: "Publication",
    body: "Le site est régénéré à partir des fichiers versionnés. Aucune API, aucun script au chargement.",
  },
];
---

<Base
  title="Vitrine — veille juridique française"
  description="Veille juridique française publiée en statique : actualités CNIL, de la plus récente à la plus ancienne."
>
  <section>
    <p class="text-[0.65rem] uppercase tracking-[0.2em] text-muted">Droit du numérique · Automatisation</p>
    <h1 class="mt-6 max-w-2xl text-4xl sm:text-5xl">
      La veille juridique, <span class="text-accent">publiée en statique</span>.
    </h1>
    <p class="mt-6 max-w-2xl text-lg text-muted">
      Un pipeline qui lit les sources officielles, normalise, versionne dans git et publie. Aucune
      API au chargement, aucun traceur : la page est écrite au moment de la publication.
    </p>

    <div class="mt-8 flex flex-wrap items-center gap-5">
      <a
        href="/veille"
        class="inline-flex items-center gap-2 rounded-md bg-accent px-5 py-3 text-sm font-medium text-paper no-underline hover:bg-ink hover:no-underline"
      >
        Consulter la veille <span aria-hidden="true">→</span>
      </a>
      <a href="#comment" class="text-sm text-muted no-underline hover:text-ink hover:underline">
        Comment ça marche
      </a>
    </div>
  </section>

  <dl class="mt-12 grid grid-cols-2 gap-px overflow-hidden rounded-md border border-ink/10 bg-ink/10 sm:grid-cols-4">
    <div class="bg-paper px-4 py-4">
      <dt class="text-[0.65rem] uppercase tracking-[0.15em] text-muted">Actualités</dt>
      <dd class="mt-1 font-serif text-2xl">{entries.length}</dd>
    </div>
    <div class="bg-paper px-4 py-4">
      <dt class="text-[0.65rem] uppercase tracking-[0.15em] text-muted">Sources</dt>
      <dd class="mt-1 font-serif text-2xl">{sources}</dd>
    </div>
    <div class="bg-paper px-4 py-4">
      <dt class="text-[0.65rem] uppercase tracking-[0.15em] text-muted">JavaScript</dt>
      <dd class="mt-1 font-serif text-2xl">0 ko</dd>
    </div>
    <div class="bg-paper px-4 py-4">
      <dt class="text-[0.65rem] uppercase tracking-[0.15em] text-muted">Coût</dt>
      <dd class="mt-1 font-serif text-2xl">0 €</dd>
    </div>
  </dl>

  <section id="comment" class="mt-20 scroll-mt-8">
    <h2 class="text-2xl">Comment ça marche</h2>
    <ol class="mt-8 grid gap-8 sm:grid-cols-3">
      {
        steps.map((step) => (
          <li class="border-t border-ink/15 pt-4">
            <span class="font-mono text-xs text-accent">{step.number}</span>
            <h3 class="mt-2 text-lg">{step.title}</h3>
            <p class="mt-2 text-sm text-muted">{step.body}</p>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="mt-20">
    <h2 class="text-2xl">Trois produits</h2>
    <ul class="mt-8 grid gap-4 sm:grid-cols-3">
      {
        products.map((product) => (
          <li class="flex flex-col rounded-md border border-ink/10 bg-surface p-5">
            <span
              class:list={[
                "inline-flex items-center gap-1.5 text-[0.6rem] uppercase tracking-[0.12em]",
                product.link ? "text-accent" : "text-muted",
              ]}
            >
              <span
                class:list={[
                  "h-1.5 w-1.5 rounded-full",
                  product.link ? "bg-accent" : "bg-muted/40",
                ]}
              />
              {product.status}
            </span>
            <h3 class="mt-3 text-lg">{product.title}</h3>
            <p class="mt-3 flex-1 text-sm text-muted">{product.body}</p>
            {product.link && (
              <a href={product.link} class="mt-4 text-sm no-underline hover:underline">
                Découvrir <span aria-hidden="true">→</span>
              </a>
            )}
          </li>
        ))
      }
    </ul>
  </section>
</Base>
