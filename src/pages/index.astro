---
import Base from "../layouts/Base.astro";

const products = [
  {
    title: "Veille active",
    body: "Les actualités de la CNIL, collectées chaque jour et publiées ici, de la plus récente à la plus ancienne.",
    link: "/veille",
    status: "Disponible",
  },
  {
    title: "MCP",
    body: "Un serveur MCP pour interroger le même corpus depuis un assistant.",
    link: null,
    status: "À venir",
  },
  {
    title: "Plugin",
    body: "Un plugin pour consulter la veille sans quitter l'outil de travail.",
    link: null,
    status: "À venir",
  },
];
---

<Base
  title="Vitrine — veille juridique française"
  description="Veille juridique française publiée en statique : actualités CNIL, de la plus récente à la plus ancienne."
>
  <h1 class="max-w-2xl text-3xl sm:text-4xl">La veille juridique française, publiée en statique.</h1>

  <p class="mt-6 max-w-2xl text-lg text-muted">
    Un corpus de sources officielles, normalisé et versionné dans git. Aucune API au chargement,
    aucun traceur : la page est écrite au moment de la publication.
  </p>

  <p class="mt-6">
    <a href="/veille">Consulter la veille</a>
  </p>

  <section class="mt-16">
    <h2 class="text-xl">Trois produits</h2>
    <ul class="mt-6 grid gap-4 sm:grid-cols-3">
      {
        products.map((product) => (
          <li class="border-t border-ink/15 pt-4">
            <h3 class="text-base">{product.title}</h3>
            <p class="mt-2 text-sm text-muted">{product.body}</p>
            <p class="mt-3 text-xs uppercase tracking-wide text-muted">
              {product.link ? <a href={product.link}>{product.status}</a> : product.status}
            </p>
          </li>
        ))
      }
    </ul>
  </section>
</Base>
