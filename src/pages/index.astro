---
import Demo from "../components/Demo.astro";
import Facade from "../components/Facade.astro";
import Base from "../layouts/Base.astro";
import { sourcesCorpus } from "../lib/corpus.ts";
import { lireDemo } from "../lib/demo.ts";
import { familleDeSource } from "../lib/familles.ts";
import { getVisibleEntries } from "../lib/entries.ts";
import { sourceLabel } from "../lib/sources.ts";

const sources = sourcesCorpus();
const publications = getVisibleEntries().slice(0, 3);
const demo = lireDemo();
const dayFormat = new Intl.DateTimeFormat("fr-FR", { day: "2-digit", timeZone: "UTC" });
const shortMonth = new Intl.DateTimeFormat("fr-FR", { month: "short", timeZone: "UTC" });
---

<Base
  title="Vitrine — une IA juridique qui cite ses sources"
  description="Un connecteur en préparation entre votre IA et les sources officielles du droit des données personnelles, et une veille des publications officielles du droit du numérique."
>
  <section class:list={[demo !== null && "grid gap-8 lg:grid-cols-12 lg:gap-10"]}>
    <div class:list={[demo !== null ? "lg:col-span-7" : "max-w-4xl"]}>
      <p class="font-mono text-[0.7rem] uppercase tracking-[0.14em] text-muted">
        Droit des données personnelles
      </p>
      <h1 class="mt-6 text-5xl sm:text-6xl lg:text-7xl">Une IA juridique qui cite ses sources.</h1>
      <p class="mt-6 max-w-xl text-lg leading-relaxed text-muted text-pretty">
        Vitrine prépare un connecteur entre votre IA et les sources officielles du droit des données
        personnelles : textes, autorités et juridictions. En attendant, consultez la veille : chaque
        publication renvoie à son texte officiel.
      </p>

      <div class="mt-8 flex flex-col items-stretch gap-4 sm:flex-row sm:flex-wrap sm:items-center sm:gap-5">
        <a
          href="/connecteur"
          class="inline-flex items-center justify-center gap-2 border-2 border-ink bg-ink px-5 py-3 font-mono text-[0.7rem] font-bold uppercase tracking-[0.12em] text-paper no-underline shadow-hard hover:-translate-x-0.5 hover:-translate-y-0.5 hover:bg-red hover:no-underline hover:shadow-hard-lg"
        >
          Découvrir le connecteur <span aria-hidden="true">→</span>
        </a>
        <a href="/veille" class="text-center text-sm text-ink underline decoration-red decoration-2 underline-offset-4">
          Consulter la veille
        </a>
      </div>
    </div>
    {
      demo !== null && (
        <div class="min-w-0 lg:col-span-5">
          <Demo demo={demo} variante="compacte" />
        </div>
      )
    }
  </section>

  {
    sources.length > 0 && (
      <section aria-labelledby="sources" class="pleine-largeur mt-14 py-8 sm:py-10">
        <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
          <h2 id="sources" class="font-mono text-[0.7rem] font-normal uppercase tracking-[0.14em]">
            Sources du connecteur
          </h2>
          <a
            href="/connecteur#couverture"
            class="font-mono text-[0.7rem] uppercase tracking-[0.12em] text-muted"
          >
            Dates par collection <span aria-hidden="true">→</span>
          </a>
        </div>
        <Facade sources={sources} class="mt-6" />
      </section>
    )
  }

  <section aria-labelledby="publications" class="mt-16">
    <div class="flex items-end justify-between gap-4 border-b-2 border-ink pb-3">
      <h2 id="publications" class="text-3xl sm:text-4xl">Dernières publications</h2>
      <a
        href="/veille"
        class="shrink-0 font-mono text-[0.7rem] uppercase tracking-[0.12em] text-ink no-underline hover:underline"
      >
        Toute la veille <span aria-hidden="true">→</span>
      </a>
    </div>
    <ol>
      {
        publications.map((entry) => {
          const date = entry.publishedAt !== null ? new Date(entry.publishedAt) : null;
          return (
            <li data-publication class="border-b-2 border-ink hover:bg-paper">
              <div class="grid grid-cols-[4rem_1fr] gap-4 py-4 sm:gap-6">
                <div class="pt-1 font-mono">
                  {date !== null ? (
                    <time datetime={entry.publishedAt ?? undefined}>
                      <span class="block text-2xl font-bold leading-none">{dayFormat.format(date)}</span>
                      <span class="mt-1 block text-[0.7rem] uppercase tracking-[0.12em] text-muted">
                        {shortMonth.format(date)}
                      </span>
                    </time>
                  ) : (
                    <span class="text-xs text-muted">Sans date</span>
                  )}
                </div>
                <div class="min-w-0">
                  <p
                    data-source={entry.source}
                    data-famille={familleDeSource(entry.source).id}
                    class="flex items-center gap-2 font-mono text-[0.7rem] uppercase tracking-[0.12em] text-muted"
                  >
                    <span
                      data-pastille
                      aria-hidden="true"
                      class:list={["inline-block h-3 w-3 shrink-0 border border-ink", familleDeSource(entry.source).classeFond]}
                    ></span>
                    {sourceLabel(entry.source)}
                  </p>
                  <h3 class="mt-1 text-lg leading-snug">
                    <a
                      href={entry.url}
                      target="_blank"
                      rel="noopener"
                      class="break-words text-ink underline decoration-red decoration-2 underline-offset-4 hover:decoration-4"
                    >
                      {entry.title}
                      <span class="sr-only"> (nouvel onglet)</span>
                    </a>
                  </h3>
                </div>
              </div>
            </li>
          );
        })
      }
    </ol>
  </section>
</Base>
