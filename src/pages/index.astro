---
import Demo from "../components/Demo.astro";
import Collage from "../components/Collage.astro";
import PublicationRangee from "../components/PublicationRangee.astro";
import Verification from "../components/Verification.astro";
import Base from "../layouts/Base.astro";
import { lireDemo } from "../lib/demo.ts";
import { getVisibleEntries } from "../lib/entries.ts";
import { FAMILLES } from "../lib/familles.ts";

const visibles = getVisibleEntries();
const publications = visibles.slice(0, 3);
const demo = lireDemo();

/** Pastilles du manifeste : la couleur de la famille, toujours suivie de son nom. */
const manifeste = [
  { avant: "Chaque réponse renvoie au texte officiel", famille: FAMILLES.textes, nom: "RGPD", apres: "publié par l'autorité" },
  { avant: "", famille: FAMILLES.autorites, nom: "CNIL", apres: "ou la juridiction" },
  { avant: "", famille: FAMILLES.ue, nom: "CJUE", apres: "qui l'a rendu. Vous vérifiez en un clic." },
];
---

<Base
  title="Vitrine — une IA juridique qui cite ses sources"
  description="Un connecteur en préparation entre votre IA et les sources officielles du droit des données personnelles, et une veille des publications officielles du droit du numérique."
>
  <section class="hero grid justify-items-center gap-8 px-1 pb-2 pt-10 text-center sm:gap-10 sm:pt-24">
    <h1 class="max-w-[14ch] text-[clamp(3rem,8.5vw,6.5rem)] leading-[0.98] tracking-[-0.02em]">
      Une IA juridique qui cite ses sources.
    </h1>
    <p class="max-w-[38rem] text-[clamp(1.125rem,2vw,1.375rem)] leading-[1.5] text-pretty text-encre-douce">
      Vitrine prépare un connecteur entre votre IA et les sources officielles du droit des données
      personnelles : textes, autorités et juridictions. En attendant, consultez la veille : chaque
      publication renvoie à son texte officiel.
    </p>

    <div class="flex flex-wrap items-center justify-center gap-3">
      <a
        href="/connecteur"
        class="inline-flex items-center justify-center gap-2 rounded-[999px] bg-accent px-6 py-4 text-[0.9375rem] font-medium leading-none tracking-[-0.01em] text-sur-accent no-underline transition-transform duration-200 hover:-translate-y-px hover:no-underline"
      >
        Découvrir le connecteur <span aria-hidden="true">→</span>
      </a>
      <a
        href="/veille"
        class="inline-flex items-center justify-center rounded-[999px] bg-accent/10 px-6 py-4 text-[0.9375rem] font-medium leading-none tracking-[-0.01em] text-encre no-underline transition-colors duration-200 hover:bg-accent/15 hover:no-underline"
      >
        Consulter la veille
      </a>
    </div>

    {
      demo !== null && (
        <div class="w-full max-w-[46rem] pt-7 text-left">
          <Demo demo={demo} variante="compacte" />
        </div>
      )
    }
  </section>

  <p class="manifeste espace-section">
    {
      manifeste.map((segment) => (
        <>
          {segment.avant !== "" && <>{segment.avant} </>}
          <span class="puce">
            <span aria-hidden="true" class:list={["h-[0.5em] w-[0.5em] shrink-0 rounded-[999px]", segment.famille.classePastille]} />
            {segment.nom}
          </span>{" "}
          {segment.apres}{" "}
        </>
      ))
    }
  </p>

  <Collage entrees={visibles} />

  <Verification />

  <section aria-labelledby="publications" class="espace-section">
    <div class="flex flex-wrap items-end justify-between gap-4 pb-4">
      <h2
        id="publications"
        class="text-[clamp(1.75rem,3.2vw,2.5rem)] font-medium leading-[1.1] tracking-[-0.025em]"
      >
        Dernières publications
      </h2>
      <a href="/veille" class="lien shrink-0">
        Toute la veille <span aria-hidden="true">→</span>
      </a>
    </div>
    <ol>
      {publications.map((entry) => <PublicationRangee entry={entry} variante="compacte" niveau="h3" />)}
    </ol>
  </section>
</Base>

<style>
  .hero > * {
    animation: monte 0.8s cubic-bezier(0.2, 0.7, 0.2, 1) both;
  }

  .hero > *:nth-child(2) {
    animation-delay: 0.06s;
  }

  .hero > *:nth-child(3) {
    animation-delay: 0.14s;
  }

  .hero > *:nth-child(4) {
    animation-delay: 0.22s;
  }

  .hero > *:nth-child(5) {
    animation-delay: 0.3s;
  }

  @keyframes monte {
    from {
      opacity: 0.35;
      transform: translateY(10px);
    }

    to {
      opacity: 1;
      transform: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero > * {
      animation: none;
    }
  }

  /* Manifeste : le grand serif porte l'idée forte, une fois. */
  .manifeste {
    font-family: var(--font-serif);
    font-size: clamp(2rem, 5.2vw, 4rem);
    line-height: 1.08;
    letter-spacing: -0.02em;
    text-align: center;
    text-wrap: balance;
    max-width: 18em;
    margin-inline: auto;
  }

  .puce {
    display: inline-flex;
    align-items: center;
    gap: 0.6em;
    vertical-align: 0.12em;
    padding: 0.55em 0.9em;
    border-radius: 999px;
    background-color: var(--color-surface);
    color: var(--color-encre);
    font-family: var(--font-texte);
    font-size: max(0.75rem, 0.3em);
    font-weight: 500;
    letter-spacing: 0;
    white-space: nowrap;
  }

  /* Lien de section : un filet fin, pas de soulignement. */
  .lien {
    border-bottom: 1px solid var(--color-filet);
    padding-bottom: 2px;
    font-size: 0.9375rem;
    font-weight: 500;
    text-decoration: none;
  }

  .lien:hover {
    border-color: var(--color-encre);
    text-decoration: none;
  }
</style>
