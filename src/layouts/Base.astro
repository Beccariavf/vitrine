---
import "@fontsource-variable/archivo/wdth.css";
import "../styles/global.css";

type Props = {
  /** Titre de l'onglet et de la page. */
  title: string;
  /** Résumé pour les moteurs et les aperçus de lien. */
  description: string;
  /** Largeur de lecture, choisie par la page. */
  containerClass?: string;
};

const { title, description, containerClass = "max-w-5xl" } = Astro.props;
const path = Astro.url.pathname;

/** Navigation principale, dans l'ordre affiché. */
const NAV = [
  { href: "/connecteur", label: "Connecteur" },
  { href: "/veille", label: "Veille" },
];
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
  </head>
  <body class="min-h-dvh bg-concrete text-ink antialiased">
    <a href="#contenu" class="skip-link">Aller au contenu</a>
    <header class="border-b-2 border-ink bg-paper">
      <div
        class:list={[
          "mx-auto flex w-full flex-wrap items-center justify-between gap-x-6 gap-y-4 px-5 py-5 sm:px-8",
          containerClass,
        ]}
      >
        <a href="/" class="flex items-center gap-3 text-ink no-underline hover:no-underline">
          <span aria-hidden="true" class="grid size-9 shrink-0 grid-cols-2 grid-rows-2 border-2 border-ink shadow-hard">
            <span class="border-r-2 border-b-2 border-ink bg-blue"></span>
            <span class="border-b-2 border-ink bg-red"></span>
            <span class="border-r-2 border-ink bg-green"></span>
            <span class="bg-yellow"></span>
          </span>
          <span class="flex flex-col">
            <span class="font-display text-3xl leading-[0.85] font-[850] tracking-[-0.01em] [font-stretch:72%]">VITRINE</span>
            <span class="mt-1 font-mono text-[0.62rem] uppercase tracking-[0.16em] text-muted">Droit du numérique</span>
          </span>
        </a>
        <nav aria-label="Navigation principale" class="flex border-2 border-ink bg-paper shadow-hard">
          {
            NAV.map((lien, index) => {
              const courant = path.startsWith(lien.href);
              return (
                <a
                  href={lien.href}
                  aria-current={courant ? "page" : undefined}
                  class:list={[
                    "px-4 py-2 font-mono text-[0.7rem] font-bold uppercase tracking-[0.12em] no-underline hover:no-underline",
                    index > 0 && "border-l-2 border-ink",
                    courant ? "bg-ink text-paper" : "text-ink hover:bg-ink hover:text-paper",
                  ]}
                >
                  {lien.label}
                </a>
              );
            })
          }
        </nav>
      </div>
    </header>

    <main id="contenu" tabindex="-1" class="flex-1 py-12 sm:py-16">
      <div class:list={["mx-auto w-full px-5 sm:px-8", containerClass]}>
        <slot />
      </div>
    </main>

    <footer class="border-t-2 border-ink bg-concrete-dark text-stone [&_a]:decoration-stone [&_a:focus-visible]:outline-paper">
      <div
        class:list={[
          "mx-auto flex w-full flex-col gap-2 px-5 py-6 font-mono text-[0.7rem] uppercase tracking-[0.12em] sm:flex-row sm:items-center sm:justify-between sm:px-8",
          containerClass,
        ]}
      >
        <div class="flex flex-col gap-1">
          <p class="text-paper">Valentin Fouich · Juriste en droit du numérique</p>
          <p class="font-sans text-xs normal-case tracking-normal">
            Outil d'aide à la recherche, ne remplace pas l'analyse d'un professionnel du droit.
          </p>
        </div>
        <p class="flex flex-wrap gap-x-5 gap-y-2">
          <a href="https://www.cnil.fr">CNIL</a>
          <a href="https://www.legifrance.gouv.fr">Légifrance</a>
          <a href="https://www.courdecassation.fr">Cour de cassation</a>
          <a href="https://eur-lex.europa.eu">EUR-Lex</a>
          <a href="https://eur-lex.europa.eu/content/legal-notice/legal-notice.html">
            Textes CJUE · CC BY 4.0
          </a>
          <a href="https://github.com/Beccariavf/vitrine">Dépôt</a>
        </p>
      </div>
    </footer>
  </body>
</html>

<style>
  .skip-link {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
  }

  .skip-link:focus {
    position: fixed;
    left: 1rem;
    top: 1rem;
    z-index: 50;
    width: auto;
    height: auto;
    margin: 0;
    padding: 0.5rem 1rem;
    overflow: visible;
    clip-path: none;
    white-space: normal;
    border: 2px solid var(--color-ink);
    background-color: var(--color-paper);
    color: var(--color-ink);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    text-decoration: none;
  }
</style>
