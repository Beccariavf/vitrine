---
import "../styles/global.css";

type Props = {
  /** Titre de l'onglet et de la page. */
  title: string;
  /** Résumé pour les moteurs et les aperçus de lien. */
  description: string;
};

const { title, description } = Astro.props;
const path = Astro.url.pathname;
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
  </head>
  <body class="min-h-screen bg-paper text-ink">
    <div class="mx-auto flex min-h-screen w-full max-w-3xl flex-col px-5 sm:px-8">
      <header class="flex flex-wrap items-baseline justify-between gap-3 border-b border-ink/10 py-6">
        <a href="/" class="font-serif text-xl tracking-tight text-ink no-underline">Vitrine</a>
        <nav aria-label="Navigation principale">
          <a
            href="/veille"
            aria-current={path.startsWith("/veille") ? "page" : undefined}
            class="text-sm text-muted no-underline hover:text-accent"
          >
            Veille
          </a>
        </nav>
      </header>

      <main class="flex-1 py-12 sm:py-16">
        <slot />
      </main>

      <footer class="border-t border-ink/10 py-8 text-sm text-muted">
        <p>Vitrine — veille juridique française, publiée en statique.</p>
        <p class="mt-1">Chaque lien renvoie à sa source officielle.</p>
      </footer>
    </div>
  </body>
</html>
