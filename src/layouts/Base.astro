---
import "@fontsource/instrument-serif/latin-400.css";
import "@fontsource-variable/inter/wght.css";
import "../styles/global.css";

type Props = {
  /** Titre de l'onglet et de la page. */
  title: string;
  /** Résumé pour les moteurs et les aperçus de lien. */
  description: string;
  /** Largeur de lecture, choisie par la page. */
  containerClass?: string;
};

const { title, description, containerClass = "max-w-5xl" } = Astro.props;
const path = Astro.url.pathname;

/** Navigation principale, dans l'ordre affiché. */
const NAV = [
  { href: "/connecteur", label: "Connecteur" },
  { href: "/veille", label: "Veille" },
];

/** Liens du pied de page : les pages, puis le dépôt. */
const PIED = [...NAV, { href: "https://github.com/Beccariavf/vitrine", label: "Code source" }];
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body class="min-h-dvh bg-fond text-encre antialiased">
    <a href="#contenu" class="skip-link">Aller au contenu</a>
    <header>
      <div
        class:list={[
          "mx-auto flex w-full items-center justify-between gap-4 px-5 py-6 sm:px-8",
          containerClass,
        ]}
      >
        <a href="/" class="flex items-baseline gap-2.5 no-underline hover:no-underline">
          <span class="font-serif text-[1.6rem] leading-none">Vitrine</span>
          <span class="hidden text-[0.8125rem] text-encre-douce min-[560px]:inline">Droit du numérique</span>
        </a>
        <nav aria-label="Navigation principale" class="flex items-center gap-1">
          {
            NAV.map((lien) => {
              const courant = path.startsWith(lien.href);
              return (
                <a
                  href={lien.href}
                  aria-current={courant ? "page" : undefined}
                  class:list={[
                    "rounded-[999px] px-[0.9rem] py-2 text-[0.9375rem] font-medium no-underline hover:no-underline",
                    courant ? "bg-accent/10 text-encre" : "text-encre hover:bg-accent/5",
                  ]}
                >
                  {lien.label}
                </a>
              );
            })
          }
        </nav>
      </div>
    </header>

    <main id="contenu" tabindex="-1" class="flex-1 py-12 sm:py-16">
      <div class:list={["mx-auto w-full px-5 sm:px-8", containerClass]}>
        <slot />
      </div>
    </main>

    <footer class="mt-20 pb-8">
      <div class:list={["mx-auto w-full px-5 sm:px-8", containerClass]}>
        <div class="grid gap-12 rounded-carte bg-surface px-5 py-[clamp(2rem,6vw,4rem)] sm:px-8">
          <nav aria-label="Pied de page" class="grid gap-0.5">
            {
              PIED.map((lien) => (
                <a
                  href={lien.href}
                  class="w-fit font-serif text-[clamp(2rem,5vw,3.25rem)] leading-[1.12] no-underline hover:text-encre-douce hover:no-underline"
                >
                  {lien.label}
                </a>
              ))
            }
          </nav>
          <div class="flex flex-col gap-4 text-[0.8125rem] text-encre-douce sm:flex-row sm:flex-wrap sm:justify-between">
            <p>Valentin Fouich · Juriste en droit du numérique</p>
            <p>Outil d'aide à la recherche, ne remplace pas l'analyse d'un professionnel du droit.</p>
            <p class="flex flex-wrap gap-x-4 gap-y-1">
              <a href="https://www.legifrance.gouv.fr">Légifrance</a>
              <a href="https://www.courdecassation.fr">Cour de cassation</a>
              <a href="https://eur-lex.europa.eu">EUR-Lex</a>
              <a href="https://eur-lex.europa.eu/content/legal-notice/legal-notice.html">Textes CJUE · CC BY 4.0</a>
            </p>
          </div>
        </div>
      </div>
    </footer>
  </body>
</html>

<style>
  .skip-link {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
  }

  .skip-link:focus {
    position: fixed;
    left: 1rem;
    top: 1rem;
    z-index: 50;
    width: auto;
    height: auto;
    margin: 0;
    padding: 0.5rem 1rem;
    overflow: visible;
    clip-path: none;
    white-space: normal;
    border: 1px solid var(--color-accent);
    border-radius: 999px;
    background-color: var(--color-fond);
    color: var(--color-encre);
    font-family: var(--font-texte);
    font-size: 0.9375rem;
    text-decoration: none;
  }
</style>
