---
import "../styles/global.css";

type Props = {
  /** Titre de l'onglet et de la page. */
  title: string;
  /** Résumé pour les moteurs et les aperçus de lien. */
  description: string;
  /** Largeur de lecture, choisie par la page. */
  containerClass?: string;
};

const { title, description, containerClass = "max-w-5xl" } = Astro.props;
const path = Astro.url.pathname;
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
  </head>
  <body class="min-h-screen bg-concrete text-ink antialiased">
    <header class="border-b-2 border-ink bg-paper">
      <div
        class:list={[
          "mx-auto flex w-full flex-wrap items-center justify-between gap-4 px-5 py-4 sm:px-8",
          containerClass,
        ]}
      >
        <a href="/" class="flex items-baseline gap-3 text-ink no-underline hover:no-underline">
          <span class="font-mono text-lg font-bold tracking-[0.08em]">VITRINE_</span>
          <span class="hidden font-mono text-[0.6rem] uppercase tracking-[0.12em] text-muted sm:inline">
            Droit du numérique
          </span>
        </a>
        <nav aria-label="Navigation principale">
          <a
            href="/veille"
            aria-current={path.startsWith("/veille") ? "page" : undefined}
            class:list={[
              "border-2 border-ink px-3 py-1 font-mono text-[0.65rem] uppercase tracking-[0.12em] no-underline hover:no-underline",
              path.startsWith("/veille")
                ? "bg-ink text-paper"
                : "bg-paper text-ink hover:bg-ink hover:text-paper",
            ]}
          >
            Veille
          </a>
        </nav>
      </div>
    </header>

    <main class="flex-1 py-12 sm:py-16">
      <div class:list={["mx-auto w-full px-5 sm:px-8", containerClass]}>
        <slot />
      </div>
    </main>

    <footer class="border-t-2 border-ink bg-paper">
      <div
        class:list={[
          "mx-auto flex w-full flex-col gap-2 px-5 py-6 font-mono text-[0.65rem] uppercase tracking-[0.12em] text-muted sm:flex-row sm:items-center sm:justify-between sm:px-8",
          containerClass,
        ]}
      >
        <p>Vitrine — veille juridique française, statique.</p>
        <p class="flex flex-wrap gap-x-5 gap-y-2">
          <a href="https://www.cnil.fr">Source : CNIL</a>
          <a href="https://github.com/Beccariavf/vitrine">Dépôt</a>
        </p>
      </div>
    </footer>
  </body>
</html>
