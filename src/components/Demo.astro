---
import type { Demo } from "../lib/demo.ts";

type Props = {
  /** Capture lue par `lireDemo`, jamais une démo fictive. */
  demo: Demo;
  /** `compacte` sur l'accueil (question, réponse avec connecteur, sources) ; `complete` avant / après. */
  variante?: "compacte" | "complete";
};

const { demo, variante = "compacte" } = Astro.props;
const complete = variante === "complete";
const dateFormat = new Intl.DateTimeFormat("fr-FR", { dateStyle: "long", timeZone: "UTC" });
---

<figure class="min-w-0 rounded-carte bg-surface p-[clamp(1rem,3vw,1.75rem)]">
  <div class="grid gap-4">
    <p class="text-[0.8125rem] text-encre-douce wrap-anywhere">
      Question · capturée le <time datetime={demo.capturee_le}>{dateFormat.format(new Date(demo.capturee_le))}</time>{" · "}{demo.modele}
    </p>
    <div class="flex items-center gap-3 rounded-[999px] bg-fond py-3 pr-3 pl-5 shadow-douce">
      <p class="min-w-0 flex-1 text-[1rem] leading-snug wrap-anywhere">« {demo.question} »</p>
      <span
        aria-hidden="true"
        class="grid h-8 w-8 shrink-0 place-items-center rounded-[999px] bg-accent text-[1rem] leading-none text-sur-accent"
      >
        ↑
      </span>
    </div>
  </div>

  <div class:list={[complete ? "mt-4 grid gap-4 md:grid-cols-2" : "px-1 pt-5"]}>
    {
      complete && (
        <div class="min-w-0 rounded-bloc bg-fond p-4 sm:p-5">
          <p class="text-[0.8125rem] text-encre-douce">Sans connecteur</p>
          <p class="mt-3 whitespace-pre-line wrap-anywhere text-[0.9375rem] leading-relaxed">{demo.sans}</p>
        </div>
      )
    }
    <div class:list={["min-w-0", complete && "rounded-bloc bg-fond p-4 sm:p-5"]}>
      <p class="text-[0.8125rem] text-encre-douce">Avec connecteur</p>
      <p class="mt-3 whitespace-pre-line wrap-anywhere text-[0.9375rem] leading-relaxed">{demo.avec}</p>
      <p class="mt-4 text-[0.8125rem] text-encre-douce">Sources</p>
      <ul class="mt-2 flex flex-wrap gap-1.5">
        {
          demo.sources.map((source) => (
            <li class="rounded-[0.5rem] border border-filet px-2.5 py-1 text-[0.8125rem] font-medium leading-snug break-words">
              <a
                href={source.url}
                target="_blank"
                rel="noopener"
                class="text-encre no-underline hover:underline hover:decoration-1 hover:underline-offset-2"
              >
                {source.libelle} <span aria-hidden="true">→</span>
                <span class="sr-only"> (nouvel onglet)</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>

  {
    complete && (
      <figcaption class="mt-4 border-t border-filet pt-3 text-[0.8125rem] text-encre-douce">
        Capture réelle, non retouchée.
      </figcaption>
    )
  }
</figure>
