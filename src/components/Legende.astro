---
import { FAMILLES_LEGENDE } from "../lib/familles.ts";

type Props = {
  /** Mention ajoutée après les familles, par exemple l'échelle de la façade. */
  complement?: string;
  class?: string;
};

const { complement, class: classe } = Astro.props;
---

<div class:list={["flex flex-wrap items-center gap-x-5 gap-y-2 text-[0.8125rem] text-encre-douce", classe]}>
  <p class="sr-only">Légende des couleurs</p>
  <ul class="contents">
    {
      FAMILLES_LEGENDE.map((famille) => (
        <li data-famille={famille.id} class="inline-flex items-center gap-1.5">
          <span
            aria-hidden="true"
            class:list={["inline-block h-[0.55rem] w-[0.55rem] shrink-0 rounded-[999px]", famille.classePastille]}
          />
          {famille.libelle}
        </li>
      ))
    }
  </ul>
  {complement !== undefined && <p>{complement}</p>}
</div>
