---
import { FAMILLES_LEGENDE } from "../lib/familles.ts";

type Props = {
  /** Mention ajoutée après les familles, par exemple l'échelle de la façade. */
  complement?: string;
  class?: string;
};

const { complement, class: classe } = Astro.props;
---

<div class:list={["flex flex-wrap items-center gap-x-4 gap-y-2 font-mono text-[0.7rem] uppercase tracking-[0.12em]", classe]}>
  <p class="sr-only">Légende des couleurs</p>
  <ul class="contents">
    {
      FAMILLES_LEGENDE.map((famille) => (
        <li data-famille={famille.id} class="inline-flex items-center gap-2">
          <span aria-hidden="true" class:list={["inline-block h-3 w-3 shrink-0 border border-ink", famille.classeFond]}></span>
          {famille.libelle}
        </li>
      ))
    }
  </ul>
  {complement !== undefined && <p class="text-muted">{complement}</p>}
</div>
