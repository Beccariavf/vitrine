---
import type { Entry } from "../lib/entries.ts";
import { isRedundantSummary } from "../lib/entries.ts";
import { familleDeSource } from "../lib/familles.ts";
import { referenceLabel, referenceUrl } from "../lib/references.ts";
import { sourceLabel } from "../lib/sources.ts";

type Props = {
  entry: Entry;
  /** `compacte` : date, source et titre (accueil) ; `complete` : avec résumé, références et matières (veille). */
  variante: "compacte" | "complete";
  /** Niveau du titre, choisi par la page selon sa hiérarchie. */
  niveau: "h2" | "h3";
  /** Libellés des matières, requis par la variante complète. */
  matieres?: Map<string, string>;
  /** Classes ajoutées à la rangée, par exemple pour le filtre des matières. */
  class?: string;
};

const { entry, variante, niveau: Titre, matieres, class: classes } = Astro.props;
const famille = familleDeSource(entry.source);
const date = entry.publishedAt !== null ? new Date(entry.publishedAt) : null;
const complete = variante === "complete";
const summary =
  complete && entry.summary !== null && !isRedundantSummary(entry.title, entry.summary) ? entry.summary : null;

/** Dates en français, à l'heure UTC : les mêmes au build comme en test. */
const dateFormat = new Intl.DateTimeFormat("fr-FR", { day: "numeric", month: "short", year: "numeric", timeZone: "UTC" });
---

<li data-publication class:list={["border-b border-filet first:border-t hover:bg-surface", classes]}>
  <div class="grid grid-cols-[6rem_1fr] gap-4 py-6 sm:grid-cols-[7rem_1fr] sm:gap-6">
    <div class="pt-0.5 text-[0.875rem] text-encre-douce tabular-nums">
      {
        date !== null ? (
          <time datetime={entry.publishedAt ?? undefined}>{dateFormat.format(date)}</time>
        ) : (
          <span>Sans date</span>
        )
      }
    </div>
    <div class="min-w-0">
      <p data-source={entry.source} data-famille={famille.id} class="flex items-center gap-1.5 text-[0.8125rem] text-encre-douce">
        <span
          data-pastille
          aria-hidden="true"
          class:list={["inline-block h-[0.55rem] w-[0.55rem] shrink-0 rounded-[999px]", famille.classePastille]}
        ></span>
        {sourceLabel(entry.source)}
      </p>
      <Titre class="mt-1.5 text-[1.125rem] leading-snug font-medium tracking-[-0.01em]">
        <a
          href={entry.url}
          target="_blank"
          rel="noopener"
          class="break-words text-encre no-underline hover:underline hover:decoration-1 hover:underline-offset-4"
        >
          {entry.title}
          <span class="sr-only"> (nouvel onglet)</span>
        </a>
      </Titre>
      {summary !== null && <p class="mt-2 line-clamp-2 text-[0.9375rem] leading-relaxed text-encre-douce">{summary}</p>}
      {
        complete && entry.references.length > 0 && (
          <ul class="mt-3 flex flex-wrap gap-1.5" aria-label="Références">
            {entry.references.map((reference) => {
              const href = referenceUrl(reference);
              return (
                <li class="rounded-[8px] border border-filet px-2.5 py-1 text-[0.8125rem] font-medium leading-snug break-words hover:border-encre-douce">
                  {href === null ? (
                    <span title={reference}>{referenceLabel(reference)}</span>
                  ) : (
                    <a
                      href={href}
                      target="_blank"
                      rel="noopener"
                      title={reference}
                      class="text-encre no-underline hover:no-underline"
                    >
                      {referenceLabel(reference)}
                      <span class="sr-only"> (nouvel onglet)</span>
                    </a>
                  )}
                </li>
              );
            })}
          </ul>
        )
      }
      {
        complete && entry.themes.length > 0 && (
          <ul class="mt-2 flex flex-wrap gap-1.5" aria-label="Matières">
            {entry.themes.map((theme) => (
              <li class="rounded-[999px] bg-accent/10 px-2.5 py-1 text-[0.75rem] font-medium">
                {matieres?.get(theme) ?? theme}
              </li>
            ))}
          </ul>
        )
      }
    </div>
  </div>
</li>
