---
import Legende from "./Legende.astro";
import { ETAGES_MAX, etagesFacade, type SourceCorpus } from "../lib/corpus.ts";
import { familleDeSource } from "../lib/familles.ts";

type Props = {
  /** Collections lues par `sourcesCorpus` ; aucune façade quand la liste est vide. */
  sources: SourceCorpus[];
  class?: string;
  /**
   * Colonnes de la grille une fois le conteneur large : 8 sur `/connecteur`, moins dans
   * une rangée de famille (3 à 6). Un nombre hors table garde 8.
   */
  colonnesLarge?: number;
  /** Masque la légende des familles et la note d'échelle (rangée de famille). */
  sansLegende?: boolean;
};

const { sources, class: classe, colonnesLarge = 8, sansLegende = false } = Astro.props;
const nombre = new Intl.NumberFormat("fr-FR");

/**
 * Grille par nombre de colonnes, classes écrites en entier pour que Tailwind les détecte.
 * Les petits nombres (rangées de famille) valent dès 22rem de conteneur : la carte d'une
 * rangée fait 376 px sur la page de 5xl, juste sous les 24rem. Les grands (8, 10) gardent
 * leur seuil de 50rem.
 */
const GRILLES_LARGE: Readonly<Record<number, string>> = {
  3: "@[22rem]:grid-cols-3",
  4: "@[22rem]:grid-cols-4",
  5: "@[22rem]:grid-cols-5",
  6: "@[22rem]:grid-cols-6",
  8: "@[50rem]:grid-cols-8",
  10: "@[50rem]:grid-cols-10",
};
const grilleLarge = GRILLES_LARGE[colonnesLarge] ?? "@[50rem]:grid-cols-8";

/** Une colonne par collection : étages calculés au build, du rez-de-chaussée vers le haut. */
const colonnes = sources.map((source) => {
  const etages = etagesFacade(source.unites);
  return {
    ...source,
    famille: familleDeSource(source.corpus),
    // Le rez-de-chaussée est un aplat ; les étages alternent ensuite loggia sur surface et aplat.
    etages: Array.from({ length: etages }, (_, rang) => etages - 1 - rang).map((niveau) => niveau % 2 === 0),
  };
});

const resume = `Façade du corpus, une colonne par collection, hauteur selon le nombre de passages indexés, en échelle logarithmique : ${colonnes
  .map((colonne) => `${colonne.libelle}, ${nombre.format(colonne.unites)} passages`)
  .join(" ; ")}.`;
---

{
  colonnes.length > 0 && (
    <figure data-facade class:list={["@container min-w-0", classe]}>
      <div
        role="img"
        aria-label={resume}
        class:list={[
          "grid grid-cols-4 gap-x-3 gap-y-6",
          colonnesLarge >= 8 && "@[24rem]:grid-cols-5 @[24rem]:gap-x-4",
          grilleLarge,
        ]}
      >
        {colonnes.map((colonne) => (
          <div data-colonne={colonne.corpus} data-famille={colonne.famille.id} class="flex min-w-0 flex-col">
            <div class="facade-hauteur flex flex-col justify-end" style={`--etages-max: ${ETAGES_MAX}`}>
              <div class="overflow-hidden rounded-t-[10px]">
                {colonne.etages.map((aplat) => (
                  <div
                    aria-hidden="true"
                    class:list={[
                      "facade-etage",
                      aplat ? colonne.famille.classeFond : "facade-loggia bg-surface",
                    ]}
                  />
                ))}
              </div>
            </div>
            <div aria-hidden="true" class="h-1.5 bg-filet" />
            <p class="mt-2 hyphens-auto text-[0.625rem] leading-tight break-words text-encre-douce sm:text-[0.6875rem]">
              {colonne.libelle}
            </p>
            <p class="mt-0.5 text-[0.625rem] text-encre-douce tabular-nums sm:text-[0.6875rem]">
              {nombre.format(colonne.unites)} passages
            </p>
          </div>
        ))}
      </div>
      {
        !sansLegende && (
          <figcaption class="mt-6 border-t border-filet pt-3">
            <Legende complement="hauteur = passages indexés (échelle log), pas le nombre de décisions" />
          </figcaption>
        )
      }
    </figure>
  )
}

<style>
  .facade-hauteur {
    height: calc(var(--etages-max) * 1.5rem + 2px);
  }

  .facade-etage {
    height: 1.5rem;
  }

  /* Loggia : la surface du fond, simplement bordée d'un filet, sans cadre encre. */
  .facade-loggia {
    box-shadow: inset 0 -1px 0 var(--color-filet);
  }

  @media (min-width: 40rem) {
    .facade-hauteur {
      height: calc(var(--etages-max) * 2.25rem + 2px);
    }

    .facade-etage {
      height: 2.25rem;
    }
  }
</style>
