---
import Legende from "./Legende.astro";
import { ETAGES_MAX, etagesFacade, type SourceCorpus } from "../lib/corpus.ts";
import { familleDeSource } from "../lib/familles.ts";

type Props = {
  /** Collections lues par `sourcesCorpus` ; aucune façade quand la liste est vide. */
  sources: SourceCorpus[];
  class?: string;
};

const { sources, class: classe } = Astro.props;
const nombre = new Intl.NumberFormat("fr-FR");

/** Une colonne par collection : étages calculés au build, du rez-de-chaussée vers le haut. */
const colonnes = sources.map((source) => {
  const etages = etagesFacade(source.unites);
  return {
    ...source,
    famille: familleDeSource(source.corpus),
    // Le rez-de-chaussée est un aplat ; les étages alternent ensuite loggia papier et aplat.
    etages: Array.from({ length: etages }, (_, rang) => etages - 1 - rang).map((niveau) => niveau % 2 === 0),
  };
});

const resume = `Façade du corpus, une colonne par collection, hauteur selon le volume indexé : ${colonnes
  .map((colonne) => `${colonne.libelle}, ${nombre.format(colonne.unites)} unités`)
  .join(" ; ")}.`;
---

{
  colonnes.length > 0 && (
    <figure data-facade class:list={["min-w-0", classe]}>
      <div role="img" aria-label={resume} class="grid grid-cols-4 gap-x-3 gap-y-6 sm:grid-cols-8 sm:gap-x-4">
        {colonnes.map((colonne) => (
          <div data-colonne={colonne.corpus} data-famille={colonne.famille.id} class="flex min-w-0 flex-col">
            <div class="facade-hauteur flex flex-col justify-end" style={`--etages-max: ${ETAGES_MAX}`}>
              <div class="border-2 border-b-0 border-ink">
                {colonne.etages.map((aplat, rang) => (
                  <div
                    aria-hidden="true"
                    class:list={[
                      "facade-etage",
                      rang > 0 && "border-t-2 border-ink",
                      aplat ? colonne.famille.classeFond : "facade-loggia bg-paper",
                    ]}
                  />
                ))}
              </div>
            </div>
            <div aria-hidden="true" class="h-1.5 bg-ink" />
            <p class="mt-2 font-mono text-[0.6rem] uppercase leading-tight tracking-normal break-words sm:text-[0.66rem] sm:tracking-[0.06em]">
              {colonne.libelle}
            </p>
            <p class="mt-0.5 font-mono text-[0.62rem] tabular-nums text-muted sm:text-[0.66rem]">
              {nombre.format(colonne.unites)}
            </p>
          </div>
        ))}
      </div>
      <figcaption class="mt-6 border-t-2 border-ink pt-3">
        <Legende complement="hauteur = volume indexé (échelle log)" />
      </figcaption>
    </figure>
  )
}

<style>
  .facade-hauteur {
    height: calc(var(--etages-max) * 1.5rem + 2px);
  }

  .facade-etage {
    height: 1.5rem;
  }

  /* Loggia : papier avec un garde-corps encre, la profondeur sans ombre ni dégradé. */
  .facade-loggia {
    box-shadow: inset 0 -0.375rem 0 0 var(--color-paper), inset 0 -0.5rem 0 0 var(--color-ink);
  }

  @media (min-width: 40rem) {
    .facade-hauteur {
      height: calc(var(--etages-max) * 2.25rem + 2px);
    }

    .facade-etage {
      height: 2.25rem;
    }
  }
</style>
