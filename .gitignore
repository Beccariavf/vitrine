# Local AI tooling (AIDD framework, third-party)
.opencode/

# Dependencies
node_modules/

# Build output
dist/
.astro/
.wrangler/

# Environment
.env
.env.*
!.env.example

# Logs
*.log

# OS
.DS_Store

# Index vectoriel dérivé, reconstruit par npm run corpus:index
data/corpus/index/

# Rapport de synchronisation : état d'une machine, réécrit par npm run corpus:sync
data/corpus/sync.json

# Dernière lecture réussie par source : état d'une machine, écrit par npm run veille
data/veille/etat.json

# Corpus CNIL : parquet DINUM non commité (334 Mo), récupéré par npm run cnil:sync
data/raw/cnil/

# Doctrine CNIL : PDF et cache de cnil.fr non commités, récupérés par npm run cnil-doctrine:sync
data/raw/cnil-doctrine/

# Corpus LIL : snapshot legiPart non commité, récupéré par npm run lil:sync
data/raw/lil/

# Corpus CE : archive JADE globale (1,32 Go) non commitée, récupérée par npm run ce:sync
data/raw/ce/

# Corpus Conseil constitutionnel : archive CONSTIT (13 Mo) non commitée, récupérée par npm run constit:sync
data/raw/constit/

# Corpus CEPD : PDF téléchargés non commités, récupérés par npm run cepd:sync
data/raw/cepd/

# Corpus Cour de cassation : cache Judilibre non commité, rempli par npm run cc:sync
data/raw/cc/

# Corpus CJUE : captures XHTML non commitées, récupérées par npm run cjue:sync
data/raw/cjue/

# Textes français d'application : snapshots PISTE non commités, récupérés par npm run textes-fr:sync
data/raw/textes_fr/

# Préparation : communications du Journal officiel non commitées, récupérées par npm run preparation:sync
data/raw/preparation/
# Métadonnées CEDH et guichet unique : pages de recherche et du registre non commitées, récupérées par npm run metadonnees:sync
data/raw/metadonnees/
