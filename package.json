{
  "name": "vitrine",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Veille juridique française publiée en statique",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "node --test tests/*.test.ts",
    "dev": "astro dev",
    "build": "ASTRO_TELEMETRY_DISABLED=1 astro build",
    "preview": "astro preview",
    "typecheck": "tsc --noEmit",
    "veille": "node veille/main.ts",
    "backfill": "node veille/backfill.ts",
    "corpus:build": "node mcp/corpus/build.ts",
    "corpus:index": "node mcp/index/build.ts",
    "mcp:smoke": "node mcp/embed/smoke.ts",
    "mcp": "node mcp/server.ts",
    "mcp:eval": "node mcp/eval/run.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "fast-xml-parser": "5.11.2",
    "sqlite-vec": "0.1.9",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.19.2",
    "astro": "7.4.4",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2"
  }
}
