#!/bin/sh
set -eu

staged=$(git diff --cached --name-only --diff-filter=ACM)

if printf '%s\n' "$staged" | grep -E '(^|/)\.env($|\.)' | grep -qv '\.env\.example$'; then
  echo "pre-commit: fichier .env détecté ; il ne doit pas être versionné." >&2
  exit 1
fi

if git diff --cached -U0 -- . ':!.env.example' | grep -qE '^\+.*PISTE_(CLIENT_SECRET|KEY_ID)=[^[:space:]]'; then
  echo "pre-commit: secret PISTE détecté dans les lignes ajoutées." >&2
  exit 1
fi
